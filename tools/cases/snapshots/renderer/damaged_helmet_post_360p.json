{
  "schemaVersion": 1,
  "id": "renderer.damaged_helmet.post_360p",
  "suite": "renderer",
  "description": "DamagedHelmet visual baseline with TAA, GTAO, and HDR postprocess at 640x360",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "DamagedHelmet/DamagedHelmet.gltf",
    "importOptions": {
      "mesh": {
        "flipUVs": true
      }
    }
  },
  "backend": "default",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 12,
  "captureFrame": 16,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [0.0, 0.25, 3.2],
    "target": [0.0, -0.05, 0.0],
    "positionDeltaPerFrame": [0.01, 0.0, 0.0],
    "verticalFovDegrees": 55.0,
    "nearPlane": 0.05,
    "farPlane": 100.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "enableDepthPrepass": true,
      "enableInstanceCompute": true,
      "enableInstanceAnimation": false,
      "enableMeshLod": true,
      "enableTessellation": false,
      "forcedMeshLod": -1
    },
    "antiAliasing": {
      "mode": "TAA",
      "qualityPreset": "Quality"
    },
    "ambientOcclusion": {
      "mode": "GTAO",
      "preset": "High"
    },
    "shadow": {
      "enabled": false,
      "qualityPreset": "Low"
    },
    "hdrPostProcess": {
      "bloomEnabled": true,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    },
    "textureFiltering": {
      "mode": "Anisotropic",
      "anisotropy": 8
    }
  },
  "requirements": {
    "assets": [
      "modelsRoot:DamagedHelmet/DamagedHelmet.gltf"
    ],
    "backends": [],
    "allowVisibleWindow": true
  },
  "captures": [
    {
      "target": "final_color",
      "profile": "ldr_color",
      "required": true
    },
    {
      "target": "ambient_occlusion",
      "profile": "scalar",
      "required": true
    },
    {
      "target": "material_normals",
      "profile": "normal",
      "required": true
    },
    {
      "target": "motion_vectors",
      "profile": "velocity",
      "required": true
    }
  ]
}
