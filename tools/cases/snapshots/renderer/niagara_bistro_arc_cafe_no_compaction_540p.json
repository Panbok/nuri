{
  "schemaVersion": 1,
  "id": "renderer.niagara_bistro.arc_cafe_hybrid128_auto_lod_540p",
  "suite": "renderer",
  "description": "Niagara Bistro cafe-side arch view with automatic LOD, hybrid indexed/meshlet shading, and current-frame Hi-Z",
  "scene": {
