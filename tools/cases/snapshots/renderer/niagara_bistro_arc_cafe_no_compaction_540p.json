  "settings": {
    "opaque": {"enabled": true, "meshletMode": "Opportunistic", "hybridClassicMaxMeshlets": 128, "enableMeshletFrustumCulling": true, "enableMeshletConeCulling": true, "enableDepthPrepass": true, "enableDepthPyramid": true, "enableInstanceCompute": false, "enableInstanceAnimation": false, "enableMeshLod": true, "enableTessellation": false, "forcedMeshLod": -1},
