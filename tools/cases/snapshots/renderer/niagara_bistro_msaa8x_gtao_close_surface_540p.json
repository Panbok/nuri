{
  "schemaVersion": 1,
  "id": "renderer.niagara_bistro.msaa8x_gtao_close_surface_540p",
  "suite": "renderer",
  "description": "Close-surface Niagara Bistro regression for MSAA depth-reconstructed GTAO normals",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
