    "antiAliasing": {"mode": "MSAA4x", "qualityPreset": "Quality"},
    "ambientOcclusion": {"mode": "Disabled", "preset": "Balanced"},
    "shadow": {"enabled": false, "qualityPreset": "Low"},
    "hdrPostProcess": {"bloomEnabled": false, "adaptationEnabled": false},
    "transmission": {"enabled": false},
    "transparent": {"enabled": false}
