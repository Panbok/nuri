{
  "schemaVersion": 1,
  "id": "renderer.niagara_bistro.msaa4x_meshlet_alpha_360p",
  "suite": "renderer",
  "description": "Niagara Bistro alpha-masked geometry on the meshlet route with MSAA4x",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
