{
  "schemaVersion": 1,
  "id": "stress.niagara_bistro.meshlet_moving_camera_720p",
  "suite": "stress",
  "description": "Niagara Bistro meshlet stress benchmark at 1280x720 with Ultra TAA, GTAO, shadows, and smooth camera movement",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "nvrhi",
  "resolution": [1280, 720],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 12,
  "measurementFrames": 600,
  "cooldownFrames": 2,
  "maxDrainFrames": 180,
  "drainTimeoutMs": 8000,
  "samples": 1,
