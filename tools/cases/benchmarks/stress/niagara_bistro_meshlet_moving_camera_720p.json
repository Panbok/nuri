  "settings": {
    "opaque": {
      "enabled": true,
      "meshletMode": "Required",
      "enableMeshletFrustumCulling": true,
      "enableMeshletConeCulling": true,
      "enableDepthPrepass": false,
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": false,
      "enableTessellation": false,
      "forcedMeshLod": 0
    },
    "antiAliasing": {
      "mode": "TAA",
      "qualityPreset": "Ultra"
    },
    "ambientOcclusion": {
      "mode": "GTAO",
      "preset": "Ultra"
    },
    "shadow": {
      "enabled": true,
      "qualityPreset": "Ultra",
      "enableMeshletDepth": true,
      "enableMeshletCascadeCulling": true
    },
    "hdrPostProcess": {
      "bloomEnabled": false,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    },
    "textureFiltering": {
      "mode": "Anisotropic",
      "anisotropy": 8
