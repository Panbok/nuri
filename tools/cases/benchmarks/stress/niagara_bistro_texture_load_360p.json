{
  "schemaVersion": 1,
  "id": "stress.niagara_bistro.texture_load_360p",
  "suite": "stress",
  "description": "Single-frame Niagara Bistro scene-load benchmark for source-native DDS reads and bounded asynchronous texture uploads",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "nvrhi",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 0,
  "measurementFrames": 1,
  "cooldownFrames": 2,
  "maxDrainFrames": 180,
  "drainTimeoutMs": 8000,
  "samples": 1,
  "authoritative": false,
  "presentMode": "immediate",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [-42.0, 6.0, -10.0],
    "target": [-20.0, 3.0, 12.0],
    "verticalFovDegrees": 60.0,
    "nearPlane": 0.05,
    "farPlane": 500.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "meshletMode": "Disabled",
      "enableDepthPrepass": false,
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": false,
      "enableTessellation": false,
      "forcedMeshLod": 0
    },
    "antiAliasing": {
      "mode": "None"
    },
    "ambientOcclusion": {
      "mode": "Disabled"
    },
    "shadow": {
      "enabled": false
    },
    "hdrPostProcess": {
      "bloomEnabled": false,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    }
  },
  "requirements": {
    "assets": [
      "modelsRoot:NiagaraBistro/bistrox.gltf"
    ],
    "backends": [
      "nvrhi"
    ],
    "allowVisibleWindow": true
  },
  "thresholds": {
    "failPercent": 15.0,
    "failAbsoluteMs": 5.0,
    "warnPercent": 8.0,
    "warnAbsoluteMs": 2.0
  },
  "requiredMetrics": [
    "cpu.scene_resource_prepare_ms",
    "texture.dds_read_ms",
    "texture.io.dds_source_read_mb",
    "texture.pack.build_ms",
    "texture.pack.open_ms",
    "texture.pack.read_ms",
    "texture.pack.hits",
    "texture.pack.misses",
    "texture.pack.stale",
    "texture.pack.corrupt",
    "texture.pack.builds",
    "texture.pack.build_failures",
    "texture.pack.read_failures",
    "texture.pack.entries_served",
    "texture.io.pack_bytes_served_mb",
    "texture.io.pack_build_source_read_mb",
    "texture.upload.textures_recorded",
    "texture.upload.recorded_mb",
    "texture.upload.batches_submitted",
    "texture.upload.bounded_batch_flushes",
    "texture.upload.completion_waits"
  ]
}
