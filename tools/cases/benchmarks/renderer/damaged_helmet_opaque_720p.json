{
  "schemaVersion": 1,
  "id": "renderer.damaged_helmet.opaque_720p",
  "suite": "renderer",
  "description": "DamagedHelmet glTF renderer baseline at 1280x720 with Ultra TAA, GTAO, and shadows",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "DamagedHelmet/DamagedHelmet.gltf",
    "importOptions": {
      "mesh": {
        "flipUVs": true
      }
    }
  },
  "backend": "default",
  "resolution": [1280, 720],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 30,
  "measurementFrames": 90,
  "cooldownFrames": 2,
  "maxDrainFrames": 120,
  "drainTimeoutMs": 5000,
  "samples": 1,
  "authoritative": false,
  "presentMode": "immediate",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [0.0, 0.25, 3.2],
    "target": [0.0, -0.05, 0.0],
    "verticalFovDegrees": 55.0,
    "nearPlane": 0.05,
    "farPlane": 100.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "enableInstanceCompute": true,
      "enableMeshLod": true,
      "enableTessellation": false,
      "forcedMeshLod": -1
    },
    "antiAliasing": {
      "mode": "TAA",
      "qualityPreset": "Ultra"
    },
    "ambientOcclusion": {
      "mode": "GTAO",
      "preset": "Ultra"
    },
    "shadow": {
      "enabled": true,
      "qualityPreset": "Ultra"
    },
    "hdrPostProcess": {
      "bloomEnabled": false,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    },
    "textureFiltering": {
      "mode": "Anisotropic",
      "anisotropy": 8
    }
  },
  "requirements": {
    "assets": [
      "modelsRoot:DamagedHelmet/DamagedHelmet.gltf"
    ],
    "backends": [],
    "allowVisibleWindow": true
  },
  "thresholds": {
    "failPercent": 10.0,
    "failAbsoluteMs": 0.2,
    "warnPercent": 5.0,
    "warnAbsoluteMs": 0.1
  },
  "requiredMetrics": [
    "cpu.render_submit_ms",
    "gpu.scopes.opaque_ms",
    "gpu.scopes.gtao_ms",
    "gpu.scopes.shadow_ms",
    "gpu.scopes.taa_resolve_ms",
    "gpu.scopes_sum_ms"
  ]
}
