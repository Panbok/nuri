{
  "schemaVersion": 1,
  "id": "aa.niagara_bistro.msaa4x_alpha_rapid",
  "suite": "aa",
  "description": "Exercise masked meshlet MSAA coverage across rapid Bistro translation, turns, and reversals",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "nvrhi",
  "resolution": [1280, 720],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 12,
  "endFrame": 96,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [-25.175787, 5.760150, 8.267586],
    "target": [-34.294270, 2.883850, 5.338666],
    "verticalFovDegrees": 60.0,
    "nearPlane": 0.05,
    "farPlane": 500.0
  },
  "settings": {
    "ddgi": {"enabled": false},
    "opaque": {
      "enabled": true,
      "meshletMode": "Required",
      "enableMeshletFrustumCulling": true,
      "enableMeshletConeCulling": true,
      "enableDepthPrepass": false,
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": false,
      "enableTessellation": false,
      "forcedMeshLod": 0
    },
    "antiAliasing": {
      "mode": "MSAA4x",
      "temporalProvider": "Reference",
      "qualityPreset": "Ultra",
      "spatialPostMsaaCleanup": false
    },
    "ambientOcclusion": {"mode": "GTAO", "preset": "Ultra"},
    "shadow": {"enabled": true, "qualityPreset": "Ultra"},
    "hdrPostProcess": {"bloomEnabled": false, "adaptationEnabled": false},
    "transmission": {"enabled": false},
    "transparent": {"enabled": false},
    "textureFiltering": {"mode": "Anisotropic", "anisotropy": 8}
  },
  "timeline": {
    "cameraPaths": [
      {
        "id": "bistro_msaa_alpha_rapid",
        "startFrame": 0,
        "endFrame": 96,
        "interpolation": "linear",
        "keyframes": [
          {"frame": 0, "position": [-25.175787, 5.760150, 8.267586], "target": [-34.294270, 2.883850, 5.338666]},
          {"frame": 24, "position": [-12.0, 6.0, 18.0], "target": [-34.0, 2.5, -2.0]},
          {"frame": 36, "position": [-26.0, 6.0, 4.0], "target": [-5.81, 6.0, -18.19]},
          {"frame": 48, "position": [-40.0, 6.0, -10.0], "target": [-20.0, 3.0, 12.0]},
          {"frame": 72, "position": [-15.0, 8.0, -8.0], "target": [-38.0, 2.0, 16.0]},
          {"frame": 84, "position": [-28.5, 6.5, 4.5], "target": [-54.49, 6.5, -20.41]},
          {"frame": 96, "position": [-25.175787, 5.760150, 8.267586], "target": [-34.294270, 2.883850, 5.338666]}
        ]
      }
    ]
  },
  "checkpoints": [
    {
      "id": "first_turn",
      "frame": 24,
      "captures": [
        {"target": "final_color", "profile": "ldr_color", "required": true, "compare": false}
      ],
      "assertions": [
        {"id": "meshlet_active", "metric": "renderer.opaque.meshlet_mode_active", "equals": 1},
        {"id": "masked_dispatches", "metric": "renderer.opaque.meshlet_alpha_masked_main_dispatches", "greaterOrEqual": 1},
        {"id": "depth_reused", "metric": "renderer.opaque.main_equal_readonly_dispatches", "greaterOrEqual": 1},
        {"id": "no_main_depth_writes", "metric": "renderer.opaque.main_less_write_dispatches", "equals": 0},
        {"id": "alpha_to_coverage", "metric": "renderer.aa.msaa_alpha_to_coverage_active", "equals": 1},
        {"id": "gtao_active", "metric": "renderer.ao.active", "equals": 1}
      ]
    },
    {
      "id": "reverse",
      "frame": 72,
      "captures": [
        {"target": "final_color", "profile": "ldr_color", "required": true, "compare": false}
      ]
    },
    {
      "id": "end",
      "frame": 96,
      "captures": [
        {"target": "final_color", "profile": "ldr_color", "required": true, "compare": false}
      ],
      "assertions": [
        {"id": "meshlet_still_active", "metric": "renderer.opaque.meshlet_mode_active", "equals": 1},
        {"id": "masked_dispatches_still_present", "metric": "renderer.opaque.meshlet_alpha_masked_main_dispatches", "greaterOrEqual": 1},
        {"id": "payload_no_overflow", "metric": "renderer.visibility.meshlet_payload_overflow_count", "equals": 0}
      ]
    }
  ],
  "metricWindows": [
    {
      "id": "rapid_motion",
      "frames": [12, 96],
      "assertions": [
        {"id": "meshlet_route_stable", "metric": "renderer.opaque.meshlet_mode_active", "equals": 1},
        {"id": "masked_work_stable", "metric": "renderer.opaque.meshlet_alpha_masked_main_dispatches", "medianMin": 1},
        {"id": "depth_reuse_stable", "metric": "renderer.opaque.main_equal_readonly_dispatches", "medianMin": 1},
        {"id": "main_depth_writes_absent", "metric": "renderer.opaque.main_less_write_dispatches", "equals": 0},
        {"id": "a2c_stable", "metric": "renderer.aa.msaa_alpha_to_coverage_active", "equals": 1},
        {"id": "gtao_stable", "metric": "renderer.ao.active", "equals": 1}
      ]
    }
  ],
  "requirements": {
    "assets": ["modelsRoot:NiagaraBistro/bistrox.gltf"],
    "backends": ["nvrhi"],
    "allowVisibleWindow": true,
    "msaaSamples": 4
  }
}
