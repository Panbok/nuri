{
  "schemaVersion": 1,
  "id": "aa.niagara_bistro.alpha_route_parity",
  "suite": "aa",
  "description": "Prove Niagara Bistro classic and meshlet alpha-masked MSAA routes activate real thresholded alpha-to-coverage pipelines",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "nvrhi",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 2,
  "endFrame": 10,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "camera": {
    "position": [-25.175787, 5.760150, 8.267586],
    "target": [-34.294270, 2.883850, 5.338666],
    "verticalFovDegrees": 60.0,
    "nearPlane": 0.05,
    "farPlane": 500.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "meshletMode": "Disabled",
      "enableDepthPrepass": true,
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": false,
      "enableTessellation": false,
      "forcedMeshLod": 0
    },
    "antiAliasing": {
      "mode": "MSAA4x"
    }
  },
  "timeline": {
    "events": [
      {
        "frame": 6,
        "type": "setSettings",
        "settings": {
          "opaque": {
            "meshletMode": "Required"
          }
        }
      }
    ]
  },
  "checkpoints": [
    {
      "id": "classic",
      "frame": 5,
      "captures": [
        {"target": "final_color", "profile": "ldr_color", "required": true, "compare": false},
        {"target": "scene_depth", "profile": "depth", "required": true, "compare": false}
      ],
      "assertions": [
        {"id": "classic_alpha_work", "metric": "renderer.opaque.classic_alpha_masked_main_draws", "greaterOrEqual": 1},
        {"id": "classic_a2c_active", "metric": "renderer.aa.msaa_alpha_to_coverage_active", "equals": 1},
        {"id": "classic_sample_shading_off", "metric": "renderer.aa.msaa_sample_shading_active", "equals": 0}
      ]
    },
    {
      "id": "meshlet",
      "frame": 10,
      "captures": [
        {"target": "final_color", "profile": "ldr_color", "required": true, "compare": false},
        {"target": "scene_depth", "profile": "depth", "required": true, "compare": false}
      ],
      "assertions": [
        {"id": "meshlet_route_active", "metric": "renderer.opaque.meshlet_mode_active", "equals": 1},
        {"id": "meshlet_alpha_dispatch", "metric": "renderer.opaque.meshlet_alpha_masked_main_dispatches", "greaterOrEqual": 1},
        {"id": "meshlet_alpha_items", "metric": "renderer.opaque.meshlet_alpha_masked_main_items", "greaterOrEqual": 1},
        {"id": "meshlet_opaque_depth_reuse", "metric": "renderer.opaque.main_equal_readonly_dispatches", "greaterOrEqual": 1},
        {"id": "meshlet_main_depth_reused", "metric": "renderer.opaque.main_less_write_dispatches", "equals": 0},
        {"id": "meshlet_a2c_active", "metric": "renderer.aa.msaa_alpha_to_coverage_active", "equals": 1},
        {"id": "meshlet_sample_shading_off", "metric": "renderer.aa.msaa_sample_shading_active", "equals": 0}
      ]
    }
  ],
  "requirements": {
    "assets": ["modelsRoot:NiagaraBistro/bistrox.gltf"],
    "backends": ["nvrhi"],
    "allowVisibleWindow": true,
    "msaaSamples": 4
  }
}
