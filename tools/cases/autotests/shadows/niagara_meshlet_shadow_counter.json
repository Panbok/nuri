{
  "schemaVersion": 1,
  "id": "shadows.niagara_bistro.meshlet_shadow_counter",
  "suite": "shadows",
  "description": "Niagara Bistro shadow meshlet cascade culling reports delayed GPU rejected-bounds counters",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "NiagaraBistro/bistrox.gltf",
    "importOptions": {
      "mesh": {
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "nvrhi",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 0,
  "endFrame": 1,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [-25.175787, 5.760150, 8.267586],
    "target": [-34.294270, 2.883850, 5.338666],
    "verticalFovDegrees": 60.0,
    "nearPlane": 0.05,
    "farPlane": 500.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "meshletMode": "Required",
      "enableMeshletFrustumCulling": false,
      "enableMeshletConeCulling": false,
      "enableDepthPrepass": false,
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": false,
      "enableTessellation": false,
      "forcedMeshLod": 0
    },
    "antiAliasing": {
      "mode": "None",
      "qualityPreset": "Balanced"
    },
    "ambientOcclusion": {
      "mode": "Disabled",
      "preset": "Balanced"
    },
    "shadow": {
      "enabled": true,
      "qualityPreset": "Medium",
      "enableMeshletDepth": true,
      "enableMeshletCascadeCulling": true
    },
    "hdrPostProcess": {
      "bloomEnabled": false,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    },
    "textureFiltering": {
      "mode": "Anisotropic",
      "anisotropy": 8
    }
  },
  "checkpoints": [
    {
      "id": "first_shadow_pass",
      "frame": 0,
      "captures": [
        {
          "target": "shadow_cascade_0",
          "profile": "shadow_depth",
          "required": true,
          "compare": false
        }
      ],
      "assertions": [
        {
          "id": "meshlet_mode_active",
          "metric": "renderer.opaque.meshlet_mode_active",
          "equals": 1
        },
        {
          "id": "meshlet_no_incompatible_fallback",
          "metric": "renderer.opaque.meshlet_rejected_incompatible_frame",
          "equals": 0
        },
        {
          "id": "shadow_meshlet_candidates_present",
          "metric": "renderer.visibility.shadow_meshlet_candidates",
          "greaterOrEqual": 1
        },
        {
          "id": "shadow_cpu_candidates_present",
          "metric": "renderer.visibility.shadow_cpu_candidates",
          "greaterOrEqual": 1
        },
        {
          "id": "shadow_cpu_rejected_present",
          "metric": "renderer.visibility.shadow_cpu_rejected",
          "greaterOrEqual": 1
        }
      ]
    },
    {
      "id": "counter_readback",
      "frame": 1,
      "captures": [
        {
          "target": "final_color",
          "profile": "ldr_color",
          "required": true,
          "compare": false
        },
        {
          "target": "shadow_cascade_0",
          "profile": "shadow_depth",
          "required": true,
          "compare": false
        }
      ],
      "assertions": [
        {
          "id": "shadow_meshlet_readback_available",
          "metric": "renderer.visibility.shadow_meshlet_readback_available",
          "equals": 1
        },
        {
          "id": "shadow_meshlet_readback_source_frame",
          "metric": "renderer.visibility.shadow_meshlet_readback_source_frame",
          "equals": 0
        },
        {
          "id": "shadow_meshlet_readback_fresh",
          "metric": "renderer.visibility.shadow_meshlet_readback_stale_frame_count",
          "equals": 1
        },
        {
          "id": "shadow_meshlet_readback_no_errors",
          "metric": "renderer.visibility.shadow_meshlet_readback_error_count",
          "equals": 0
        },
        {
          "id": "shadow_meshlet_bounds_counter_readback",
          "metric": "renderer.visibility.shadow_meshlet_rejected_bounds",
          "greaterOrEqual": 1
        }
      ]
    }
  ],
  "requirements": {
    "assets": ["modelsRoot:NiagaraBistro/bistrox.gltf"],
    "backends": ["nvrhi"],
    "allowVisibleWindow": true
  }
}
