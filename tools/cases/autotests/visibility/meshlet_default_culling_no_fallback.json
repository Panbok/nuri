{
  "schemaVersion": 1,
  "id": "visibility.meshlet_default_culling_no_fallback",
  "suite": "visibility",
  "description": "Default visibility culling keeps the meshlet path active instead of falling back",
  "scene": {
    "kind": "prefab",
    "pathBase": "modelsRoot",
    "path": "DamagedHelmet/DamagedHelmet.gltf",
    "importOptions": {
      "mesh": {
        "flipUVs": true,
        "generateMeshlets": true,
        "meshletMaxVertices": 64,
        "meshletMaxPrimitives": 124,
        "meshletConeWeight": 0.0
      }
    }
  },
  "backend": "default",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 4,
  "endFrame": 12,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [0.0, 0.25, 3.2],
    "target": [0.0, -0.05, 0.0],
    "verticalFovDegrees": 55.0,
    "nearPlane": 0.05,
    "farPlane": 100.0
  },
  "settings": {
    "opaque": {
      "enabled": true,
      "meshletMode": "Required",
      "enableInstanceCompute": false,
      "enableInstanceAnimation": false,
      "enableMeshLod": true,
      "enableTessellation": false,
      "forcedMeshLod": -1
    },
    "antiAliasing": {
      "mode": "None",
      "qualityPreset": "Balanced"
    },
    "ambientOcclusion": {
      "mode": "Disabled",
      "preset": "Balanced"
    },
    "shadow": {
      "enabled": false,
      "qualityPreset": "Low"
    },
    "hdrPostProcess": {
      "bloomEnabled": false,
      "adaptationEnabled": false
    },
    "transmission": {
      "enabled": false
    },
    "transparent": {
      "enabled": false
    },
    "textureFiltering": {
      "mode": "Anisotropic",
      "anisotropy": 8
    }
  },
  "checkpoints": [
    {
      "id": "end",
      "frame": 12,
      "captures": [
        {
          "target": "final_color",
          "profile": "ldr_color",
          "required": true,
          "compare": false
        }
      ],
      "assertions": [
        {
          "id": "meshlet_mode_active",
          "metric": "renderer.opaque.meshlet_mode_active",
          "equals": 1
        },
        {
          "id": "meshlet_no_incompatible_fallback",
          "metric": "renderer.opaque.meshlet_rejected_incompatible_frame",
          "equals": 0
        },
        {
          "id": "meshlet_candidates_present",
          "metric": "renderer.opaque.meshlet_candidates",
          "greaterOrEqual": 1
        }
      ]
    }
  ],
  "requirements": {
    "assets": ["modelsRoot:DamagedHelmet/DamagedHelmet.gltf"],
    "backends": [],
    "allowVisibleWindow": true
  }
}
