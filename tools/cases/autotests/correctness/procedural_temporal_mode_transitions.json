{
  "schemaVersion": 1,
  "id": "correctness.procedural.temporal_mode_transitions",
  "suite": "correctness",
  "description": "Camera-cut and temporal-history behavior across TAA, SpatialAA, MSAA, and TAA re-entry",
  "scene": {
