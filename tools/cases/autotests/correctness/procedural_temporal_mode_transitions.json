      {
        "frame": 8,
        "type": "setSettings",
        "settings": {
          "antiAliasing": {
            "mode": "SpatialFallback"
          }
        }
      },
      {
        "frame": 12,
        "type": "setSettings",
        "settings": {
          "antiAliasing": {
            "mode": "MSAA4x"
          }
        }
      },
      {
        "frame": 16,
        "type": "setSettings",
        "settings": {
          "antiAliasing": {
            "mode": "TAA",
            "qualityPreset": "Quality"
          }
        }
      }
    ]
