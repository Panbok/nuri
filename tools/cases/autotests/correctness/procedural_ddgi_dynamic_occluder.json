{
  "schemaVersion": 1,
  "id": "correctness.procedural.ddgi_dynamic_occluder",
  "suite": "correctness",
  "description": "Moves an occluder after convergence and verifies TLAS update ordering plus DDGI geometry response",
  "scene": {
    "kind": "procedural",
    "generator": "nuri.procedural.ddgi_dynamic_occluder.v1",
    "seed": 1,
