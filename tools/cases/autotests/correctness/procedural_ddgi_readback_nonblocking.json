{
  "schemaVersion": 1,
  "id": "correctness.procedural.ddgi_readback_nonblocking",
  "suite": "correctness",
  "description": "Completion-tagged DDGI telemetry advances without waits, blocking fallbacks, early slot reuse, or generation mismatches",
  "scene": {
    "kind": "procedural",
    "generator": "nuri.procedural.ddgi_hybrid_warmup.v1",
    "seed": 1,
    "contentHash": "nuri.procedural.ddgi_hybrid_warmup.v1:1"
  },
  "backend": "default",
  "resolution": [640, 360],
  "fixedDeltaSeconds": 0.016666667,
  "warmupFrames": 2,
  "endFrame": 32,
  "authoritative": false,
  "presentMode": "immediate",
  "windowMode": "visible",
  "renderGraph": {
    "workerCount": 1,
    "parallelCompile": false,
    "parallelRecording": false
  },
  "camera": {
    "position": [0.0, 0.75, 4.2],
    "target": [0.0, 0.25, 0.0],
    "verticalFovDegrees": 60.0,
    "nearPlane": 0.05,
    "farPlane": 100.0
  },
  "settings": {
    "ddgi": {
      "enabled": true,
      "preset": "Custom",
      "raysPerProbe": 64,
      "maxProbeUpdatesPerFrame": 192,
      "maxRayQueriesPerFrame": 12288,
      "coverage": {
        "schemaVersion": 1,
        "mode": "Hybrid",
        "constraintPolicy": "PreserveCoverage",
        "sceneBoundsSource": "Authored",
        "authoredBounds": {
          "min": [-6.0, -2.0, -5.0],
          "max": [6.0, 2.5, 5.0]
        },
        "cascadeCount": 3,
        "cascadeProbeCounts": [6, 4, 6],
        "requestedNearSpacing": [0.75, 0.75, 0.75],
        "spacingRatio": 2.0,
        "requestedCoverageHalfExtents": [8.0, 4.0, 8.0],
        "scenePaddingCells": 1,
        "transitionCells": 1,
        "includeAuthoredVolumes": false
      }
    },
    "antiAliasing": {"mode": "None"},
    "ambientOcclusion": {"mode": "Disabled"},
    "shadow": {"enabled": false},
    "hdrPostProcess": {"bloomEnabled": false, "adaptationEnabled": false}
  },
  "checkpoints": [
    {
      "id": "completed_telemetry",
      "frame": 32,
      "captures": [
        {
          "target": "frame_color_hdr",
          "profile": "hdr_color",
          "required": true,
          "compare": false
        }
      ],
      "assertions": [
        {"id": "no_waits", "metric": "renderer.ddgi.readback_waits", "equals": 0},
        {"id": "no_blocking_fallbacks", "metric": "renderer.ddgi.readback_blocking_fallbacks", "equals": 0},
        {"id": "no_early_reuse", "metric": "renderer.ddgi.readback_early_reuse_attempts", "equals": 0},
        {"id": "no_generation_mismatch", "metric": "renderer.ddgi.readback_generation_mismatches", "equals": 0},
        {"id": "trace_source_available", "metric": "renderer.ddgi.trace_counter_source_frame", "greaterOrEqual": 1}
      ]
    }
  ],
  "requirements": {
    "assets": ["modelsRoot:common/flat_plane.obj"],
    "backends": [],
    "allowVisibleWindow": true,
    "accelerationStructure": true,
    "rayQuery": true
  }
}
