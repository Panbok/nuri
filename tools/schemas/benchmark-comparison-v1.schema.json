{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nuri.dev/schemas/benchmark-comparison-v1.schema.json", "title": "Nuri benchmark comparison v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "valid", "authoritative", "regression", "errors", "warnings", "metrics"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "nuri.benchmark.comparison" }, "valid": { "type": "boolean" }, "authoritative": { "type": "boolean" }, "regression": { "type": "boolean" }, "errors": { "type": "array", "items": { "type": "string" } }, "warnings": { "type": "array", "items": { "type": "string" } }, "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } } },
  "$defs": { "metric": { "type": "object", "additionalProperties": false, "required": ["metricId", "statistic", "baseline", "current", "delta", "deltaPercent", "deltaPercentAvailable", "status", "required", "repeatComparison"], "properties": { "metricId": { "type": "string" }, "statistic": { "type": "string" }, "baseline": { "type": "number" }, "current": { "type": "number" }, "delta": { "type": "number" }, "deltaPercent": { "type": ["number", "null"] }, "deltaPercentAvailable": { "type": "boolean" }, "status": { "type": "string" }, "required": { "type": "boolean" }, "repeatComparison": { "type": ["object", "null"] } } } }
}
