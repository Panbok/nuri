{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nuri.dev/schemas/autotest-report-v1.schema.json",
  "title": "Nuri autotest detailed report payload (read-only v1 evidence)", "$comment": "Direct v1 documents are investigative. Authority is carried only by a compatible enclosing v2 result and governed baseline evidence.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "baselineProfile", "generatedAtUtc", "command", "status", "exitCode", "selection", "environment", "case", "run", "artifacts", "checkpoints", "metricWindows", "frames", "unavailableMetrics", "warnings", "errors", "reproduceCommand"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "nuri.autotest.report" }, "baselineProfile": { "type": "string" }, "generatedAtUtc": { "type": "string" }, "command": { "type": "string" }, "status": { "type": "string" }, "exitCode": { "type": "integer", "minimum": 0, "maximum": 5 }, "selection": { "$ref": "#/$defs/selection" }, "environment": { "type": "object" }, "case": { "type": "object" }, "run": { "type": "object" }, "artifacts": { "$ref": "#/$defs/artifacts" }, "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } }, "metricWindows": { "type": "array", "items": { "$ref": "#/$defs/window" } }, "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } }, "unavailableMetrics": { "$ref": "#/$defs/strings" }, "warnings": { "$ref": "#/$defs/strings" }, "errors": { "$ref": "#/$defs/strings" }, "reproduceCommand": { "type": "string" } },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } }, "path": { "type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$" }, "numbers": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
    "selection": { "type": "object", "additionalProperties": false, "required": ["requested", "selected", "attempted", "completed", "passed", "failed", "unavailable", "notRun"], "properties": { "requested": { "type": "string" }, "selected": { "type": "integer", "minimum": 0 }, "attempted": { "type": "integer", "minimum": 0 }, "completed": { "type": "integer", "minimum": 0 }, "passed": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 }, "unavailable": { "type": "integer", "minimum": 0 }, "notRun": { "type": "integer", "minimum": 0 } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["artifactDir", "rootHtml", "caseDir", "caseHtml"], "properties": { "artifactDir": { "$ref": "#/$defs/path" }, "rootHtml": { "$ref": "#/$defs/path" }, "caseDir": { "$ref": "#/$defs/path" }, "caseHtml": { "$ref": "#/$defs/path" } } },
    "assertion": { "type": "object", "additionalProperties": false, "required": ["id", "metric", "statistic", "status", "statusReason", "hasActual", "actual", "sampleCount", "expectedSampleCount"], "properties": { "id": { "type": "string" }, "metric": { "type": "string" }, "statistic": { "type": "string" }, "status": { "type": "string" }, "statusReason": { "type": "string" }, "hasActual": { "type": "boolean" }, "actual": { "type": ["number", "null"] }, "sampleCount": { "type": "integer", "minimum": 0 }, "expectedSampleCount": { "type": "integer", "minimum": 0 } } },
    "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["id", "frame", "measurements", "captures", "readouts", "assertions", "warnings", "errors"], "properties": { "id": { "type": "string" }, "frame": { "type": "integer", "minimum": 0 }, "measurements": { "$ref": "#/$defs/numbers" }, "captures": { "type": "array", "items": { "type": "object" } }, "readouts": { "type": "array", "items": { "type": "object" } }, "assertions": { "$ref": "#/$defs/assertions" }, "warnings": { "$ref": "#/$defs/strings" }, "errors": { "$ref": "#/$defs/strings" } } },
    "window": { "type": "object", "additionalProperties": false, "required": ["id", "startFrame", "endFrame", "assertions", "warnings", "errors"], "properties": { "id": { "type": "string" }, "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 }, "assertions": { "$ref": "#/$defs/assertions" }, "warnings": { "$ref": "#/$defs/strings" }, "errors": { "$ref": "#/$defs/strings" } } },
    "frame": { "type": "object", "additionalProperties": false, "required": ["frameIndex", "measurements", "unavailableMetrics"], "properties": { "frameIndex": { "type": "integer", "minimum": 0 }, "measurements": { "$ref": "#/$defs/numbers" }, "unavailableMetrics": { "$ref": "#/$defs/strings" } } }
  }
}
