{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nuri.dev/schemas/autotest-suite-report-v1.schema.json", "title": "Nuri autotest suite payload v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "baselineProfile", "investigative", "generatedAtUtc", "command", "suite", "status", "exitCode", "selection", "artifactDir", "children", "diagnostics"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "nuri.autotest.suite_report" }, "baselineProfile": { "type": "string" }, "investigative": { "type": "boolean" }, "generatedAtUtc": { "type": "string" }, "command": { "type": "string" }, "suite": { "type": "string" }, "status": { "type": "string" }, "exitCode": { "type": "integer", "minimum": 0, "maximum": 5 }, "selection": { "$ref": "autotest-report-v1.schema.json#/$defs/selection" }, "artifactDir": { "type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$" }, "children": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "exitCode", "report", "html"], "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "exitCode": { "type": "integer", "minimum": 0, "maximum": 5 }, "report": { "type": "string" }, "html": { "type": "string" } } } }, "diagnostics": { "type": "array", "items": { "type": "string" } } }
}
