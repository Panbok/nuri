{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nuri.dev/schemas/benchmark-suite-report-v1.schema.json", "title": "Nuri benchmark suite payload v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "suite", "outcome", "exitCode", "baselineProfile", "profileAuthoritative", "authoritative", "minimumIndependentRepetitions", "completedIndependentRepetitions", "repetitionUnit", "warmupStabilityStatus", "selectedCount", "executedCount", "caseReports"],
  "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "nuri.benchmark.suite_report" }, "suite": { "type": "string" }, "outcome": { "type": "string" }, "exitCode": { "type": "integer", "minimum": 0, "maximum": 5 }, "baselineProfile": { "type": "string" }, "profileAuthoritative": { "type": "boolean" }, "authoritative": { "type": "boolean" }, "minimumIndependentRepetitions": { "type": "integer", "minimum": 0 }, "completedIndependentRepetitions": { "type": "integer", "minimum": 0 }, "repetitionUnit": { "type": "string" }, "warmupStabilityStatus": { "type": "string" }, "selectedCount": { "type": "integer", "minimum": 0 }, "executedCount": { "type": "integer", "minimum": 0 }, "caseReports": { "type": "array", "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" } } }
}
