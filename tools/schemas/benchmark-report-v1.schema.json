{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuri.dev/schemas/benchmark-report-v1.schema.json",
  "title": "Nuri benchmark detailed report (read-only v1 evidence)",
  "$comment": "Authority is decided by the enclosing v2 result and governed baseline evidence, never by this v1 document alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAtUtc", "command", "environment", "case", "run", "artifacts", "frames", "sampleStats", "stats", "renderGraph", "resourceStats", "timingDrain", "unavailableMetrics", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "nuri.benchmark.report" },
    "generatedAtUtc": { "type": "string" }, "command": { "type": "string" },
    "environment": { "$ref": "#/$defs/environment" }, "case": { "$ref": "#/$defs/case" },
    "profile": { "$ref": "#/$defs/profile" },
    "repeatObservations": { "type": "object", "additionalProperties": false, "required": ["unit", "independent", "count"], "properties": { "unit": { "type": "string" }, "independent": { "type": "boolean" }, "count": { "type": "integer", "minimum": 0 } } },
    "run": { "$ref": "#/$defs/run" }, "artifacts": { "$ref": "#/$defs/artifacts" },
    "tracy": { "type": "object" },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
    "sampleStats": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
    "stats": { "$ref": "#/$defs/statsMap" },
    "renderGraph": { "type": "object", "maxProperties": 0 },
    "resourceStats": { "type": "object", "maxProperties": 0 },
    "timingDrain": { "$ref": "#/$defs/drain" },
    "unavailableMetrics": { "$ref": "#/$defs/strings" },
    "unregisteredObservedMetrics": { "$ref": "#/$defs/strings" },
    "warnings": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "path": { "type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$" },
    "environment": { "type": "object", "additionalProperties": false, "required": ["repoRoot", "commitHash", "branchName", "dirty", "osName", "osVersion", "cpuName", "cpuLogicalThreadCount", "gpuBackend", "gpuBackendSource", "gpuDeviceName", "swapchainImageCount", "requestedPresentMode", "resolvedPresentMode", "presentModeSource", "windowMode", "windowVisible", "renderGraphWorkerCount", "renderGraphParallelCompile", "renderGraphParallelRecording", "renderGraphWorkerCountSource", "renderGraphParallelCompileSource", "renderGraphParallelRecordingSource", "buildType", "cmakeToolProfile", "vcpkgManifestFeatures", "NURI_BUILD_SHARED", "NURI_WITH_LOGGING", "NURI_WITH_ASSERTS", "NURI_WITH_TRACY", "NURI_WITH_TRACY_GPU", "NURI_WITH_TRACY_GPU_DRAW_ZONES", "tracyDiagnostic", "devChecks"], "properties": {
      "repoRoot": { "$ref": "#/$defs/path" }, "commitHash": { "type": "string" }, "branchName": { "type": "string" }, "dirty": { "type": "boolean" }, "osName": { "type": "string" }, "osVersion": { "type": "string" }, "cpuName": { "type": "string" }, "cpuLogicalThreadCount": { "type": "integer", "minimum": 0 }, "gpuBackend": { "type": "string" }, "gpuBackendSource": { "type": "string" }, "gpuDeviceName": { "type": "string" }, "gpuVendorId": { "type": "integer", "minimum": 0 }, "gpuDeviceId": { "type": "integer", "minimum": 0 }, "gpuDriverVersion": { "type": "string" }, "swapchainImageCount": { "type": "integer", "minimum": 0 }, "requestedPresentMode": { "type": "string" }, "resolvedPresentMode": { "type": "string" }, "presentModeSource": { "type": "string" }, "windowMode": { "type": "string" }, "windowVisible": { "type": "boolean" }, "renderGraphWorkerCount": { "type": "integer", "minimum": 0 }, "renderGraphParallelCompile": { "type": "boolean" }, "renderGraphParallelRecording": { "type": "boolean" }, "renderGraphWorkerCountSource": { "type": "string" }, "renderGraphParallelCompileSource": { "type": "string" }, "renderGraphParallelRecordingSource": { "type": "string" }, "buildType": { "type": "string" }, "cmakeToolProfile": { "type": "string" }, "vcpkgManifestFeatures": { "type": "string" }, "NURI_BUILD_SHARED": { "type": "boolean" }, "NURI_WITH_LOGGING": { "type": "boolean" }, "NURI_WITH_ASSERTS": { "type": "boolean" }, "NURI_WITH_TRACY": { "type": "boolean" }, "NURI_WITH_TRACY_GPU": { "type": "boolean" }, "NURI_WITH_TRACY_GPU_DRAW_ZONES": { "type": "boolean" }, "tracyDiagnostic": { "type": "boolean" }, "devChecks": { "type": "boolean" }
    } },
    "case": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "suite", "description", "manifestPath", "backend", "resolution", "presentMode", "authoritative", "fixedDeltaSeconds", "warmupFrames", "measurementFrames", "cooldownFrames", "maxDrainFrames", "drainTimeoutMs", "samples", "settingsSignature", "configSignature", "requiredMetrics", "thresholds", "scene", "renderGraph", "camera", "requirements", "settings"], "properties": {
      "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "suite": { "type": "string" }, "description": { "type": "string" }, "manifestPath": { "$ref": "#/$defs/path" }, "backend": { "type": "string" }, "resolution": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "minItems": 2, "maxItems": 2 }, "presentMode": { "type": "string" }, "authoritative": { "type": "boolean" }, "fixedDeltaSeconds": { "type": "number" }, "warmupFrames": { "type": "integer", "minimum": 0 }, "measurementFrames": { "type": "integer", "minimum": 0 }, "cooldownFrames": { "type": "integer", "minimum": 0 }, "maxDrainFrames": { "type": "integer", "minimum": 0 }, "drainTimeoutMs": { "type": "integer", "minimum": 0 }, "samples": { "type": "integer", "minimum": 0 }, "settingsSignature": { "type": "string" }, "configSignature": { "type": "string" }, "requiredMetrics": { "$ref": "#/$defs/strings" }, "thresholds": { "type": "object" }, "scene": { "type": "object" }, "renderGraph": { "type": "object" }, "camera": { "type": "object" }, "timeline": { "type": "object" }, "requirements": { "type": "object" }, "settings": { "type": "object" }
    } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "profileAuthoritative", "authoritative", "minimumRepetitions", "completedRepetitions", "repetitionRequirementSatisfied", "repetitionUnit", "warmupStabilityPolicy", "warmupStabilityStatus", "requiredMetrics", "authorityBlockers"], "properties": { "id": { "type": "string" }, "profileAuthoritative": { "type": "boolean" }, "authoritative": { "type": "boolean" }, "minimumRepetitions": { "type": "integer", "minimum": 0 }, "completedRepetitions": { "type": "integer", "minimum": 0 }, "repetitionRequirementSatisfied": { "type": "boolean" }, "repetitionUnit": { "type": "string" }, "warmupStabilityPolicy": { "type": "string" }, "warmupStabilityStatus": { "type": "string" }, "warmupWindowFrames": { "type": "integer", "minimum": 0 }, "warmupMaxDriftPercent": { "type": "number", "minimum": 0 }, "requiredMetrics": { "$ref": "#/$defs/strings" }, "authorityBlockers": { "$ref": "#/$defs/strings" } } },
    "run": { "type": "object", "additionalProperties": false, "required": ["samples", "warmupFrames", "measurementFrames", "cooldownFrames", "maxDrainFrames", "drainTimeoutMs", "validForComparison", "fixedDeltaSeconds"], "properties": { "samples": { "type": "integer", "minimum": 0 }, "warmupFrames": { "type": "integer", "minimum": 0 }, "measurementFrames": { "type": "integer", "minimum": 0 }, "cooldownFrames": { "type": "integer", "minimum": 0 }, "maxDrainFrames": { "type": "integer", "minimum": 0 }, "drainTimeoutMs": { "type": "integer", "minimum": 0 }, "validForComparison": { "type": "boolean" }, "fixedDeltaSeconds": { "type": "number" } } },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["artifactDir", "caseReports", "tracy"], "properties": { "artifactDir": { "$ref": "#/$defs/path" }, "caseReports": { "type": "array", "items": { "$ref": "#/$defs/path" } }, "tracy": { "type": "array", "items": { "$ref": "#/$defs/path" } } } },
    "frame": { "type": "object", "additionalProperties": false, "required": ["frameIndex", "sampleIndex", "measured", "measurements"], "properties": { "frameIndex": { "type": "integer", "minimum": 0 }, "sampleIndex": { "type": "integer", "minimum": 0 }, "measured": { "type": "boolean" }, "measurements": { "type": "object", "additionalProperties": { "type": "number" } }, "metrics": { "type": "object" } } },
    "stats": { "type": "object", "additionalProperties": false, "required": ["count", "min", "median", "p90", "p95", "max", "mean", "stddev", "mad", "iqr", "coefficientOfVariation"], "properties": { "count": { "type": "integer", "minimum": 0 }, "min": { "type": "number" }, "median": { "type": "number" }, "p90": { "type": "number" }, "p95": { "type": "number" }, "max": { "type": "number" }, "mean": { "type": "number" }, "stddev": { "type": "number" }, "mad": { "type": "number" }, "iqr": { "type": "number" }, "coefficientOfVariation": { "type": "number" } } },
    "statsMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stats" } },
    "sample": { "type": "object", "additionalProperties": false, "required": ["sampleIndex", "measuredFrameStart", "measuredFrameCount", "stats", "warnings"], "properties": { "sampleIndex": { "type": "integer", "minimum": 0 }, "warmupStable": { "type": ["boolean", "null"] }, "measuredFrameStart": { "type": "integer", "minimum": 0 }, "measuredFrameCount": { "type": "integer", "minimum": 0 }, "stats": { "$ref": "#/$defs/statsMap" }, "warnings": { "$ref": "#/$defs/strings" } } },
    "drain": { "type": "object", "additionalProperties": false, "required": ["drainComplete", "drainFrames", "drainTimeoutMs", "missingGpuTimingFrames", "droppedGpuTimingReports"], "properties": { "drainComplete": { "type": "boolean" }, "drainFrames": { "type": "integer", "minimum": 0 }, "drainTimeoutMs": { "type": "integer", "minimum": 0 }, "missingGpuTimingFrames": { "type": "integer", "minimum": 0 }, "droppedGpuTimingReports": { "type": "integer", "minimum": 0 } } }
  }
}
