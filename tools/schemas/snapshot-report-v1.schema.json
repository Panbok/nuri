{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nuri.dev/schemas/snapshot-report-v1.schema.json",
  "title": "Nuri snapshot detailed report (read-only v1 evidence)", "$comment": "Authority is decided by the enclosing v2 result and governed baseline evidence.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAtUtc", "command", "environment", "case", "artifacts", "captures", "availableCapturePoints", "captureSynchronization", "rendererMetrics", "rendererMetricValues", "reproduceCommand", "warnings", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "nuri.snapshot.report" }, "generatedAtUtc": { "type": "string" }, "command": { "type": "string" },
    "baselineProfile": { "type": "string" }, "baselineProfileCompatible": { "type": "boolean" }, "baselineProfileIncompatibilityReasons": { "$ref": "#/$defs/strings" },
    "environment": { "type": "object" },
    "case": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "id", "suite", "description", "backend", "resolution", "presentMode", "windowMode", "warmupFrames", "captureFrame", "authoritative", "captures"], "properties": { "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "suite": { "type": "string" }, "description": { "type": "string" }, "backend": { "type": "string" }, "resolution": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2 }, "presentMode": { "type": "string" }, "windowMode": { "type": "string" }, "warmupFrames": { "type": "integer", "minimum": 0 }, "captureFrame": { "type": "integer", "minimum": 0 }, "authoritative": { "type": "boolean" }, "captures": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["target", "profile", "required"], "properties": { "target": { "type": "string" }, "profile": { "type": "string" }, "required": { "type": "boolean" } } } } } },
    "artifacts": { "$ref": "#/$defs/artifacts" }, "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "availableCapturePoints": { "$ref": "#/$defs/strings" }, "captureSynchronization": { "type": "string" }, "rendererMetrics": { "type": "object" }, "rendererMetricValues": { "type": "object", "additionalProperties": { "type": "number" } }, "renderGraph": { "type": "object" }, "reproduceCommand": { "type": "string" }, "warnings": { "$ref": "#/$defs/strings" }, "errors": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } }, "path": { "type": "string", "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*$" },
    "artifacts": { "type": "object", "additionalProperties": false, "required": ["artifactDir", "rootHtml", "caseDir", "caseHtml"], "properties": { "artifactDir": { "$ref": "#/$defs/path" }, "rootHtml": { "$ref": "#/$defs/path" }, "caseDir": { "$ref": "#/$defs/path" }, "caseHtml": { "$ref": "#/$defs/path" } } },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["meanAbsError", "rmse", "maxAbsError", "p99AbsError", "failingValues", "comparedValues"], "properties": { "meanAbsError": { "type": "number" }, "rmse": { "type": "number" }, "maxAbsError": { "type": "number" }, "p99AbsError": { "type": "number" }, "failingValues": { "type": "integer", "minimum": 0 }, "comparedValues": { "type": "integer", "minimum": 0 } } },
    "capture": { "type": "object", "additionalProperties": false, "required": ["target", "artifactStem", "profile", "required", "available", "capturePointVersion", "captureFrameIndex", "kind", "lifetime", "format", "colorSpace", "origin", "width", "height", "mip", "layer", "actualHash", "expectedHash", "actual", "actualMetadata", "preview", "expected", "diff", "metrics", "producerPassLabel", "readbackError", "status", "statusReason"], "properties": { "target": { "type": "string" }, "artifactStem": { "type": "string" }, "profile": { "type": "string" }, "required": { "type": "boolean" }, "available": { "type": "boolean" }, "capturePointVersion": { "type": "integer", "minimum": 0 }, "captureFrameIndex": { "type": "integer", "minimum": 0 }, "kind": { "type": "string" }, "lifetime": { "type": "string" }, "format": { "type": "string" }, "colorSpace": { "type": "string" }, "origin": { "type": "string" }, "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 }, "mip": { "type": "integer", "minimum": 0 }, "layer": { "type": "integer", "minimum": 0 }, "actualHash": { "type": "string" }, "expectedHash": { "type": "string" }, "actual": { "$ref": "#/$defs/path" }, "actualMetadata": { "$ref": "#/$defs/path" }, "preview": { "$ref": "#/$defs/path" }, "expected": { "$ref": "#/$defs/path" }, "diff": { "$ref": "#/$defs/path" }, "metrics": { "$ref": "#/$defs/metrics" }, "semanticMetrics": { "type": "object" }, "failedThresholds": { "$ref": "#/$defs/strings" }, "producerPassLabel": { "type": "string" }, "readbackError": { "type": "string" }, "status": { "type": "string" }, "statusReason": { "type": "string" } } }
  }
}
