{
  "name": "nuri",
  "version-string": "0.1.0",
  "builtin-baseline": "7c11b72a6f810293d0ce234de126b99e9ab6fa7a",
  "dependencies": [
    "glm",
    "assimp",
    "stb",
    "harfbuzz",
    "glfw3",
    "glslang",
    {
      "name": "tracy",
      "default-features": false
    },
    "meshoptimizer",
    "yyjson",
    "unordered-dense",
    "ktx",
    "volk"
  ],
  "features": {
    "editor": {
      "description": "Build the nuri editor target",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "glfw-binding"
          ]
        },
        "implot"
      ]
    },
    "tests": {
      "description": "Build the nuri test targets",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmark-tools": {
      "description": "Build the nuri renderer benchmarking tools",
      "dependencies": [
        "cli11",
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "cli-tools"
          ]
        }
      ]
    },
    "snapshot-tools": {
      "description": "Build the nuri renderer visual snapshot tools",
      "dependencies": [
        "cli11",
        "openimageio"
      ]
    },
    "autotest-tools": {
      "description": "Build the nuri renderer autotesting tools",
      "dependencies": [
        "cli11",
        "openimageio"
      ]
    },
    "tools": {
      "description": "Build nuri automation tools",
      "dependencies": [
        "cli11",
        "openimageio"
      ]
    }
  }
}
