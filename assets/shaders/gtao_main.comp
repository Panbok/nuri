#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 2, r16) uniform image2D kImagesR16[];

const uint kViewDepthMipCount = 5u;
const float kPi = 3.14159265359;
const float kHalfPi = 1.57079632679;
const float kMaxVisibilityReduction = 0.45;
const float kSampleDistributionPower = 2.0;
const float kPixelTooCloseThreshold = 1.3;
const float kDepthMipSamplingOffset = 3.3;
const float kEffectFalloffRange = 0.615;
const float kCenterDepthBias = 0.99999;
const float kThinEdgeMipBias = 1.75;
const float kThinEdgeRadiusPixels = 64.0;
const float kForegroundSilhouetteEdgeThreshold = 0.35;
const float kForegroundSilhouetteDepthFraction = 0.02;
const float kForegroundDepthRejectStart = 0.03;
const float kForegroundDepthRejectEnd = 0.18;
const float kForegroundContactStartPixels = 6.0;
const float kForegroundContactEndPixels = 14.0;
const int kForegroundEdgeTraceSteps = 4;

layout(push_constant) uniform constants {
  uint depthTexIds[kViewDepthMipCount];
  uint normalTexId;
  uint edgeTexId;
  uint outputTexId;
  uint outputWidth;
  uint outputHeight;
  uint workingWidth;
  uint workingHeight;
  uint noiseIndex;
  uint sliceCount;
  uint stepCount;
  uint strengthBits;
  uint radiusBits;
  float tanHalfFovY;
  float aspectRatio;
  float orthoHeight;
  uint projectionType;
  uint inputMode;
}
pc;

float unpackFloat(uint bits) { return uintBitsToFloat(bits); }

float safeAcos(float value) { return acos(clamp(value, -1.0, 1.0)); }

uint hilbertIndex(uint x, uint y) {
  x &= 63u;
  y &= 63u;
  uint index = 0u;
  for (uint s = 32u; s > 0u; s >>= 1u) {
    uint rx = (x & s) != 0u ? 1u : 0u;
    uint ry = (y & s) != 0u ? 1u : 0u;
    index += s * s * ((3u * rx) ^ ry);
    if (ry == 0u) {
      if (rx != 0u) {
        x = 63u - x;
        y = 63u - y;
      }
      uint t = x;
      x = y;
      y = t;
    }
  }
  return index;
}

vec2 spatioTemporalNoise(ivec2 pixel, uint temporalIndex) {
  uint index = hilbertIndex(uint(pixel.x), uint(pixel.y));
  index += 288u * (temporalIndex % 64u);
  return fract(vec2(0.5) +
               float(index) * vec2(0.7548776662466928, 0.5698402909980533));
}

vec4 sampleTexture(uint texId, ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(texId)], pos, 0);
}

ivec2 mipSize(uint mipLevel) {
  return max(
      ivec2(int(pc.outputWidth >> mipLevel), int(pc.outputHeight >> mipLevel)),
      ivec2(1));
}

float sampleViewDepthLevel(uint mipLevel, vec2 uv) {
  uint clampedMip = min(mipLevel, kViewDepthMipCount - 1u);
  ivec2 size = mipSize(clampedMip);
  ivec2 pos = clamp(ivec2(floor(uv * vec2(size))), ivec2(0), size - ivec2(1));
  return texelFetch(kTextures2D[nonuniformEXT(pc.depthTexIds[clampedMip])], pos,
                    0)
      .r;
}

float sampleViewDepth(float mipLevel, vec2 uv) {
  float clampedMip = clamp(mipLevel, 0.0, float(kViewDepthMipCount - 1u));
  uint mip0 = uint(floor(clampedMip));
  uint mip1 = min(mip0 + 1u, kViewDepthMipCount - 1u);
  float depth0 = sampleViewDepthLevel(mip0, uv);
  float blend = fract(clampedMip);
  if (blend <= 1.0e-5 || mip0 == mip1) {
    return depth0;
  }
  float depth1 = sampleViewDepthLevel(mip1, uv);
  return mix(depth0, depth1, blend);
}

float samplePackedEdges(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.edgeTexId)], pos, 0).r;
}

vec4 unpackEdges(float packedEdges) {
  uint packedValue = uint(packedEdges * 255.5);
  vec4 edgesLRTB;
  edgesLRTB.x = float((packedValue >> 6) & 0x03u) / 3.0;
  edgesLRTB.y = float((packedValue >> 4) & 0x03u) / 3.0;
  edgesLRTB.z = float((packedValue >> 2) & 0x03u) / 3.0;
  edgesLRTB.w = float((packedValue >> 0) & 0x03u) / 3.0;
  return clamp(edgesLRTB, 0.0, 1.0);
}

float thinEdgeMipBias(ivec2 pos, float radiusPixels) {
  vec4 edges = unpackEdges(samplePackedEdges(pos));
  float weakestEdge = min(min(edges.x, edges.y), min(edges.z, edges.w));
  float edgeStrength = 1.0 - weakestEdge;
  float radiusStrength = clamp(
      (kThinEdgeRadiusPixels - radiusPixels) / kThinEdgeRadiusPixels, 0.0, 1.0);
  return kThinEdgeMipBias * edgeStrength * mix(0.5, 1.0, radiusStrength);
}

float edgeForDirection(vec4 edges, vec2 direction) {
  vec2 axisWeight = abs(direction);
  float weightSum = max(axisWeight.x + axisWeight.y, 1.0e-5);
  float horizontal = direction.x < 0.0 ? edges.x : edges.y;
  float vertical = direction.y < 0.0 ? edges.z : edges.w;
  return (horizontal * axisWeight.x + vertical * axisWeight.y) / weightSum;
}

float pathEdgeVisibility(ivec2 pos, vec2 signedOffset, ivec2 size) {
  float visibility = 1.0;
  for (int i = 0; i < kForegroundEdgeTraceSteps; ++i) {
    float t = (float(i) + 0.5) / float(kForegroundEdgeTraceSteps);
    ivec2 samplePos =
        clamp(pos + ivec2(round(signedOffset * t)), ivec2(0), size - ivec2(1));
    vec4 edges = unpackEdges(samplePackedEdges(samplePos));
    visibility = min(visibility, edgeForDirection(edges, signedOffset));
  }
  return visibility;
}

vec3 reconstructViewPosition(vec2 uv, float viewDepth) {
  vec2 ndc = uv * 2.0 - 1.0;
  if (pc.projectionType != 0u) {
    float halfHeight = max(pc.orthoHeight, 1.0e-4) * 0.5;
    return vec3(ndc.x * halfHeight * max(pc.aspectRatio, 1.0e-4),
                -ndc.y * halfHeight, -viewDepth);
  }

  float yScale = max(pc.tanHalfFovY, 1.0e-4);
  return vec3(ndc.x * yScale * max(pc.aspectRatio, 1.0e-4) * viewDepth,
              -ndc.y * yScale * viewDepth, -viewDepth);
}

float viewDepthAt(ivec2 pos, ivec2 size) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.depthTexIds[0])],
                    clamp(pos, ivec2(0), size - ivec2(1)), 0)
      .r;
}

bool reconstructViewNormal(ivec2 pos, float centerDepth, out vec3 normal) {
  ivec2 size = ivec2(int(pc.outputWidth), int(pc.outputHeight));
  float leftDepth = viewDepthAt(pos + ivec2(-1, 0), size);
  float rightDepth = viewDepthAt(pos + ivec2(1, 0), size);
  float topDepth = viewDepthAt(pos + ivec2(0, -1), size);
  float bottomDepth = viewDepthAt(pos + ivec2(0, 1), size);
  bool leftValid = leftDepth > 1.0e-5;
  bool rightValid = rightDepth > 1.0e-5;
  bool topValid = topDepth > 1.0e-5;
  bool bottomValid = bottomDepth > 1.0e-5;
  if ((!leftValid && !rightValid) || (!topValid && !bottomValid)) {
    normal = vec3(0.0);
    return false;
  }

  vec2 centerUv = (vec2(pos) + vec2(0.5)) / vec2(size);
  vec2 texel = 1.0 / vec2(size);
  vec3 center = reconstructViewPosition(centerUv, centerDepth);
  bool useLeft = leftValid &&
                 (!rightValid ||
                  abs(leftDepth - centerDepth) < abs(rightDepth - centerDepth));
  bool useTop = topValid &&
                (!bottomValid ||
                 abs(topDepth - centerDepth) < abs(bottomDepth - centerDepth));
  float horizontalDepth = useLeft ? leftDepth : rightDepth;
  float verticalDepth = useTop ? topDepth : bottomDepth;
  float discontinuityLimit = max(0.05, centerDepth * 0.10);
  if (abs(horizontalDepth - centerDepth) > discontinuityLimit ||
      abs(verticalDepth - centerDepth) > discontinuityLimit) {
    normal = vec3(0.0);
    return false;
  }

  vec2 horizontalUv = centerUv + vec2(useLeft ? -texel.x : texel.x, 0.0);
  vec2 verticalUv = centerUv + vec2(0.0, useTop ? -texel.y : texel.y);
  vec3 horizontal = reconstructViewPosition(horizontalUv, horizontalDepth);
  vec3 vertical = reconstructViewPosition(verticalUv, verticalDepth);
  vec3 dx = useLeft ? center - horizontal : horizontal - center;
  vec3 dy = useTop ? center - vertical : vertical - center;
  float dxLengthSq = dot(dx, dx);
  float dyLengthSq = dot(dy, dy);
  if (!(dxLengthSq > 0.0) || !(dyLengthSq > 0.0) || isinf(dxLengthSq) ||
      isinf(dyLengthSq)) {
    normal = vec3(0.0);
    return false;
  }
  normal = cross(dy, dx);
  float normalLengthSq = dot(normal, normal);
  if (!(normalLengthSq > 1.0e-6 * dxLengthSq * dyLengthSq) ||
      isinf(normalLengthSq)) {
    normal = vec3(0.0);
    return false;
  }
  normal *= inversesqrt(normalLengthSq);
  vec3 toCamera = normalize(-center);
  if (dot(normal, toCamera) < 0.0) {
    normal = -normal;
  }
  return true;
}

bool selectDepthRepresentative(ivec2 workingPos, out ivec2 fullPos,
                               out float viewDepth, out vec4 normalSample) {
  ivec2 outputSize = ivec2(int(pc.outputWidth), int(pc.outputHeight));
  bool halfResolution =
      pc.workingWidth != pc.outputWidth || pc.workingHeight != pc.outputHeight;
  ivec2 footprint = halfResolution ? ivec2(2) : ivec2(1);
  ivec2 basePos = halfResolution ? workingPos * 2 : workingPos;
  bool found = false;
  viewDepth = 0.0;
  fullPos = clamp(basePos, ivec2(0), outputSize - ivec2(1));
  normalSample = vec4(0.0);
  for (int y = 0; y < footprint.y; ++y) {
    for (int x = 0; x < footprint.x; ++x) {
      ivec2 candidatePos =
          clamp(basePos + ivec2(x, y), ivec2(0), outputSize - ivec2(1));
      float candidateDepth =
          texelFetch(kTextures2D[nonuniformEXT(pc.depthTexIds[0])],
                     candidatePos, 0)
              .r;
      vec4 candidateNormal = vec4(0.0);
      bool valid = candidateDepth > 1.0e-5;
      if (valid && pc.inputMode == 0u) {
        candidateNormal = sampleTexture(pc.normalTexId, candidatePos);
        vec3 decodedNormal = candidateNormal.xyz * 2.0 - 1.0;
        valid = candidateNormal.a > 0.0 &&
                dot(decodedNormal, decodedNormal) > 1.0e-6;
      } else if (valid) {
        vec3 reconstructedNormal;
        valid = reconstructViewNormal(candidatePos, candidateDepth,
                                      reconstructedNormal);
        candidateNormal =
            vec4(reconstructedNormal * 0.5 + 0.5, valid ? 1.0 : 0.0);
      }
      if (valid && (!found || candidateDepth < viewDepth)) {
        found = true;
        viewDepth = candidateDepth;
        fullPos = candidatePos;
        normalSample = candidateNormal;
      }
    }
  }
  return found;
}

void main() {
  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
  ivec2 workingSize = ivec2(int(pc.workingWidth), int(pc.workingHeight));
  ivec2 outputSize = ivec2(int(pc.outputWidth), int(pc.outputHeight));
  if (pos.x >= workingSize.x || pos.y >= workingSize.y) {
    return;
  }

  ivec2 fullPos;
  float centerDepth;
  vec4 normalSample;
  if (!selectDepthRepresentative(pos, fullPos, centerDepth, normalSample)) {
    imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
               vec4(1.0, 0.0, 0.0, 0.0));
    return;
  }
  vec2 invWorkingSize = 1.0 / vec2(workingSize);
  vec2 halfOutputTexel = vec2(0.5) / vec2(outputSize);
  vec2 uv = (vec2(fullPos) + vec2(0.5)) / vec2(outputSize);
  vec3 viewNormal = normalSample.xyz * 2.0 - 1.0;
  float normalLenSq = dot(viewNormal, viewNormal);
  viewNormal *= inversesqrt(normalLenSq);

  uint slices = max(pc.sliceCount, 1u);
  uint steps = max(pc.stepCount, 1u);
  float effectRadius = max(unpackFloat(pc.radiusBits), 0.25);
  float viewUnitsPerPixel =
      pc.projectionType != 0u
          ? max(pc.orthoHeight, 1.0e-4) / max(float(pc.workingHeight), 1.0)
          : (2.0 * max(pc.tanHalfFovY, 1.0e-4) * centerDepth) /
                max(float(pc.workingHeight), 1.0);
  float radiusPixels = min(effectRadius / max(viewUnitsPerPixel, 1.0e-4), 96.0);
  if (radiusPixels < kPixelTooCloseThreshold) {
    imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
               vec4(1.0, 0.0, 0.0, 0.0));
    return;
  }

  vec3 centerPos = reconstructViewPosition(uv, centerDepth * kCenterDepthBias);
  vec3 viewVec = normalize(-centerPos);
  viewNormal =
      normalize(viewNormal + max(0.0, -dot(viewNormal, viewVec)) * viewVec);

  vec2 noise = spatioTemporalNoise(pos, pc.noiseIndex);
  float minS = kPixelTooCloseThreshold / radiusPixels;
  float resolutionScale = max(float(pc.outputWidth) / float(pc.workingWidth),
                              float(pc.outputHeight) / float(pc.workingHeight));
  float centerMipBias =
      thinEdgeMipBias(fullPos, radiusPixels * resolutionScale);
  float falloffRange = max(kEffectFalloffRange * effectRadius, 1.0e-4);
  float falloffFrom = effectRadius * (1.0 - kEffectFalloffRange);
  float falloffMul = -1.0 / falloffRange;
  float falloffAdd = falloffFrom / falloffRange + 1.0;
  float foregroundDepthThreshold =
      max(effectRadius * kForegroundSilhouetteDepthFraction,
          viewUnitsPerPixel * 2.0);
  float foregroundDepthRejectStart =
      max(kForegroundDepthRejectStart, viewUnitsPerPixel * 2.0);
  float foregroundDepthRejectEnd =
      max(foregroundDepthRejectStart + 1.0e-4,
          min(kForegroundDepthRejectEnd, effectRadius * 0.12));
  float visibility = 0.0;

  for (uint slice = 0u; slice < slices; ++slice) {
    float sliceNoise = fract(noise.x + float(slice) * 0.61803398875);
    float sampleNoise = fract(noise.y + float(slice) * 0.75487766625);
    float angle = (float(slice) + sliceNoise) * (kPi / float(slices));
    float cosAngle = cos(angle);
    float sinAngle = sin(angle);
    vec2 dir = vec2(cosAngle, sinAngle);
    vec3 directionVec = vec3(cosAngle, sinAngle, 0.0);
    vec3 orthoDirection = directionVec - dot(directionVec, viewVec) * viewVec;
    float orthoLenSq = dot(orthoDirection, orthoDirection);
    if (orthoLenSq <= 1.0e-6) {
      visibility += 1.0;
      continue;
    }
    orthoDirection *= inversesqrt(orthoLenSq);

    vec3 axis = normalize(cross(orthoDirection, viewVec));
    vec3 projectedNormal = viewNormal - axis * dot(viewNormal, axis);
    float projectedNormalLen = length(projectedNormal);
    if (projectedNormalLen <= 1.0e-5) {
      visibility += 1.0;
      continue;
    }

    float signNorm = sign(dot(orthoDirection, projectedNormal));
    float cosNorm =
        clamp(dot(projectedNormal, viewVec) / projectedNormalLen, 0.0, 1.0);
    float normalAngle = signNorm * safeAcos(cosNorm);
    float lowHorizonCos0 = cos(normalAngle + kHalfPi);
    float lowHorizonCos1 = cos(normalAngle - kHalfPi);
    float horizonCos0 = lowHorizonCos0;
    float horizonCos1 = lowHorizonCos1;

    for (uint stepIndex = 0u; stepIndex < steps; ++stepIndex) {
      float stepNoise =
          fract(sampleNoise + (float(slice) + float(stepIndex) * float(steps)) *
                                  0.61803398875);
      float stepRatio = (float(stepIndex) + stepNoise) / float(steps);
      stepRatio = pow(clamp(stepRatio, 0.0, 1.0), kSampleDistributionPower);
      stepRatio += minS;
      vec2 sampleOffset =
          round(dir * max(stepRatio * radiusPixels, kPixelTooCloseThreshold));
      float offsetLength = max(length(sampleOffset), 1.0);
      float fullResolutionOffsetLength = offsetLength * resolutionScale;
      float mipLevel = clamp(log2(fullResolutionOffsetLength) -
                                 kDepthMipSamplingOffset - centerMipBias,
                             0.0, float(kViewDepthMipCount - 1u));

      for (int side = 0; side < 2; ++side) {
        vec2 signedOffset = side == 0 ? sampleOffset : -sampleOffset;
        vec2 sampleUv = clamp(uv + signedOffset * invWorkingSize,
                              halfOutputTexel, 1.0 - halfOutputTexel);
        float sampleDepth = sampleViewDepth(mipLevel, sampleUv);
        if (sampleDepth <= 1.0e-5) {
          continue;
        }

        float foregroundDelta = centerDepth - sampleDepth;
        float foregroundSilhouetteVisibility = 1.0;
        if (foregroundDelta > foregroundDepthThreshold) {
          float depthSeparatedVisibility =
              1.0 - smoothstep(foregroundDepthRejectStart,
                               foregroundDepthRejectEnd, foregroundDelta);
          float contactVisibility =
              1.0 - smoothstep(kForegroundContactStartPixels,
                               kForegroundContactEndPixels,
                               fullResolutionOffsetLength);
          foregroundSilhouetteVisibility = contactVisibility;
          if (depthSeparatedVisibility > contactVisibility) {
            float edgeSeparatedVisibility = smoothstep(
                kForegroundSilhouetteEdgeThreshold, 1.0,
                pathEdgeVisibility(fullPos, signedOffset * resolutionScale,
                                   outputSize));
            foregroundSilhouetteVisibility =
                max(contactVisibility,
                    min(depthSeparatedVisibility, edgeSeparatedVisibility));
          }
        }

        vec3 samplePos = reconstructViewPosition(sampleUv, sampleDepth);
        vec3 sampleDelta = samplePos - centerPos;
        float sampleDist = length(sampleDelta);
        if (sampleDist <= 1.0e-5) {
          continue;
        }

        vec3 horizonVec = sampleDelta / sampleDist;
        float horizonCos = dot(horizonVec, viewVec);
        float falloff = clamp(sampleDist * falloffMul + falloffAdd, 0.0, 1.0) *
                        foregroundSilhouetteVisibility;
        if (side == 0) {
          horizonCos0 =
              max(horizonCos0, mix(lowHorizonCos0, horizonCos, falloff));
        } else {
          horizonCos1 =
              max(horizonCos1, mix(lowHorizonCos1, horizonCos, falloff));
        }
      }
    }

    projectedNormalLen = mix(projectedNormalLen, 1.0, 0.05);
    float h0 = -safeAcos(horizonCos1);
    float h1 = safeAcos(horizonCos0);
    float iarc0 =
        (cosNorm + 2.0 * h0 * sin(normalAngle) - cos(2.0 * h0 - normalAngle)) *
        0.25;
    float iarc1 =
        (cosNorm + 2.0 * h1 * sin(normalAngle) - cos(2.0 * h1 - normalAngle)) *
        0.25;
    visibility += clamp(projectedNormalLen * (iarc0 + iarc1), 0.0, 1.0);
  }

  float rawVisibility = clamp(visibility / float(slices), 0.0, 1.0);
  float strength = clamp(unpackFloat(pc.strengthBits), 0.0, 1.0);
  visibility = mix(1.0, rawVisibility, strength);
  visibility = max(visibility, 1.0 - kMaxVisibilityReduction);
  imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
             vec4(visibility, 0.0, 0.0, 0.0));
}
