// NURI_SHADER_FEATURE_RAY_QUERY
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define NURI_CUSTOM_PUSH_CONSTANTS 1
#include "common.sp"
#include "ddgi_common.sp"
#include "rt_material.sp"

layout(std430, buffer_reference) readonly buffer DDGIProbeUpdateBuffer {
  DDGIProbeUpdateEntryGpu values[];
};
layout(std430, buffer_reference) buffer DDGIRayResultBuffer {
  DDGIRayResultGpuData values[];
};
struct DDGITraceCountersGpuData {
  uint primaryCandidateIntersections;
  uint secondaryQueries;
  uint secondaryCandidateIntersections;
  uint alphaCandidateRejections;
  uint backfaceCandidateRejections;
  uint candidateOverflows;
  uint localLightTruncations;
  uint primaryQueriesIssued;
  uint secondaryQueriesReserved;
  uint sourceFrame;
  uint localSecondaryQueries;
  uint secondaryQueryBudgetOverflows;
  uint nonFiniteRadianceRejects;
  uint emissiveRadianceClamps;
  uint directRadianceClamps;
  uint skyRadianceClamps;
  uint multiBounceRadianceClamps;
  uint finalRadianceClamps;
  uint reserved1;
  uint reserved2;
  uint primaryQueriesIssuedByVolume[8];
  uint secondaryQueriesByVolume[8];
};
layout(std430, buffer_reference) buffer DDGITraceInputBuffer {
  DDGITraceCountersGpuData counters;
  LocalLightGpuData lights[];
};

layout(push_constant) uniform PushConstants {
  DDGIFrameBuffer frame;
  DDGIProbeUpdateBuffer updates;
  DDGIRayResultBuffer results;
  RtInstanceBuffer instances;
  RtGeometryBuffer geometries;
  MaterialHeaderBuffer materials;
  vec4 directionalDirectionIlluminance;
  vec4 directionalColor;
  DDGITraceInputBuffer traceInputs;
  uint updateCount;
  uint raysPerProbe;
  uint skyTextureId;
  uint skySamplerId;
  uint maxCandidates;
  uint frameSeed;
  uint materialSamplerId;
  uint directionalLightCount;
  uint localLightCount;
  uint maxLocalLights;
}
pc;

const uint kDDGIRadianceDomainEmissive = 0u;
const uint kDDGIRadianceDomainDirect = 1u;
const uint kDDGIRadianceDomainSky = 2u;
const uint kDDGIRadianceDomainMultiBounce = 3u;
const uint kDDGIRadianceDomainFinal = 4u;

bool ddgiDiagnosticCountersEnabled() {
  return (pc.maxLocalLights & 0x40000000u) != 0u;
}

uint ddgiPresetRayCount() { return pc.raysPerProbe & 0xfffu; }

vec3 ddgiFiniteRadiance(vec3 value) {
  if (any(isnan(value)) || any(isinf(value))) {
    if (ddgiDiagnosticCountersEnabled()) {
      atomicAdd(pc.traceInputs.counters.nonFiniteRadianceRejects, 1u);
    }
    return vec3(0.0);
  }
  return max(value, vec3(0.0));
}

vec3 ddgiClampRadiance(vec3 value, uint domain) {
  value = ddgiFiniteRadiance(value);
  const float valueLuminance = dot(value, vec3(0.2126, 0.7152, 0.0722));
  const float limit = max(pc.directionalColor.w, 0.0);
  if (valueLuminance > limit && ddgiDiagnosticCountersEnabled()) {
    if (domain == kDDGIRadianceDomainEmissive) {
      atomicAdd(pc.traceInputs.counters.emissiveRadianceClamps, 1u);
    } else if (domain == kDDGIRadianceDomainDirect) {
      atomicAdd(pc.traceInputs.counters.directRadianceClamps, 1u);
    } else if (domain == kDDGIRadianceDomainSky) {
      atomicAdd(pc.traceInputs.counters.skyRadianceClamps, 1u);
    } else if (domain == kDDGIRadianceDomainMultiBounce) {
      atomicAdd(pc.traceInputs.counters.multiBounceRadianceClamps, 1u);
    } else {
      atomicAdd(pc.traceInputs.counters.finalRadianceClamps, 1u);
    }
  }
  return value * min(1.0, limit / max(valueLuminance, 1.0e-6));
}

bool ddgiDirectLightVisible(vec3 origin, vec3 direction, float maximumDistance,
                            uint volumeSlot, bool localLight) {
  uint reservedIndex = atomicAdd(pc.traceInputs.counters.secondaryQueries, 0u);
  for (;;) {
    if (reservedIndex >= pc.traceInputs.counters.secondaryQueriesReserved) {
      // This is scheduler feedback, not optional diagnostics. It only executes
      // on overflow and keeps the next frame's reservation conservative.
      atomicAdd(pc.traceInputs.counters.secondaryQueryBudgetOverflows, 1u);
      return false;
    }
    const uint observed =
        atomicCompSwap(pc.traceInputs.counters.secondaryQueries, reservedIndex,
                       reservedIndex + 1u);
    if (observed == reservedIndex) {
      break;
    }
    reservedIndex = observed;
  }
  if (localLight && ddgiDiagnosticCountersEnabled()) {
    atomicAdd(pc.traceInputs.counters.localSecondaryQueries, 1u);
  }
  if (ddgiDiagnosticCountersEnabled()) {
    atomicAdd(pc.traceInputs.counters.secondaryQueriesByVolume[volumeSlot], 1u);
  }
  rayQueryEXT shadowQuery;
  rayQueryInitializeEXT(shadowQuery, kSceneTlas,
                        gl_RayFlagsTerminateOnFirstHitEXT, 0xff, origin, 0.001,
                        direction, maximumDistance);
  uint candidates = 0u;
  bool overflow = false;
  while (rayQueryProceedEXT(shadowQuery)) {
    if (ddgiDiagnosticCountersEnabled()) {
      atomicAdd(pc.traceInputs.counters.secondaryCandidateIntersections, 1u);
    }
    if (++candidates > (pc.maxCandidates & 0xffffu)) {
      overflow = true;
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.candidateOverflows, 1u);
      }
      break;
    }
    const uint instanceIndex =
        rayQueryGetIntersectionInstanceCustomIndexEXT(shadowQuery, false);
    const RtInstanceGpuData instance = pc.instances.values[instanceIndex];
    const uint geometryIndex =
        instance.geometryRenderableFlags.x +
        rayQueryGetIntersectionGeometryIndexEXT(shadowQuery, false);
    RtGeometryGpuData geometry = pc.geometries.values[geometryIndex];
    if ((geometry.flags &
         (kRtGeometryAlphaBlended | kRtGeometryTransmission)) != 0u) {
      continue;
    }
    const uint primitive =
        rayQueryGetIntersectionPrimitiveIndexEXT(shadowQuery, false);
    const vec2 bary =
        rayQueryGetIntersectionBarycentricsEXT(shadowQuery, false);
    const float candidateDistance =
        rayQueryGetIntersectionTEXT(shadowQuery, false);
    if (!rtAlphaPasses(geometry, instance, primitive, bary, pc.materials,
                       pc.materialSamplerId, candidateDistance,
                       ddgiPresetRayCount())) {
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.alphaCandidateRejections, 1u);
      }
      continue;
    }
    const bool front = rayQueryGetIntersectionFrontFaceEXT(shadowQuery, false);
    if (!front && (geometry.flags & kRtGeometryDoubleSided) == 0u) {
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.backfaceCandidateRejections, 1u);
      }
      continue;
    }
    rayQueryConfirmIntersectionEXT(shadowQuery);
  }
  return !overflow && rayQueryGetIntersectionTypeEXT(shadowQuery, true) ==
                          gl_RayQueryCommittedIntersectionNoneEXT;
}

uint ddgiDirectLightHash(uint value) {
  value ^= value >> 16u;
  value *= 0x7feb352du;
  value ^= value >> 15u;
  value *= 0x846ca68bu;
  value ^= value >> 16u;
  return value;
}

float ddgiDirectLightRandom(uint sampleSeed, uint volumeSlot) {
  const uint seed = sampleSeed ^ (volumeSlot * 0x85ebca6bu);
  return float(ddgiDirectLightHash(seed) & 0x00ffffffu) / 16777216.0;
}

vec3 ddgiDirectLighting(vec3 hitPoint, vec3 geometricNormal, vec3 shadingNormal,
                        vec3 diffuseColor, float minimumSpacing,
                        uint volumeSlot, uint sampleSeed) {
  const uint localLimit = min(pc.maxLocalLights & 0xffffu, 16u);
  const uint selectedDirectionalLightCount = pc.directionalLightCount & 0xffffu;
  const uint totalDirectionalLightCount = pc.directionalLightCount >> 16u;
  DDGIVolumeGpuData volume = pc.frame.volumes[volumeSlot];
  const uint sampledLocalLightOffset =
      volume.resourceFlagsLocalLightSubset.y >> 16u;
  const uint sampledLocalLightCount =
      volume.resourceFlagsLocalLightSubset.y & 0xffffu;
  const uint totalLocalLightCount = pc.localLightCount >> 16u;
  const float localDomainScale =
      sampledLocalLightCount > 0u
          ? float(totalLocalLightCount) / float(sampledLocalLightCount)
          : 0.0;
  uint candidateIndices[16];
  float candidateScores[16];
  uint candidateCount = 0u;
  uint eligibleCount = 0u;
  for (uint lightIndex = 0u; lightIndex < sampledLocalLightCount;
       ++lightIndex) {
    const LocalLightGpuData light =
        pc.traceInputs.lights[sampledLocalLightOffset + lightIndex];
    if (!localLightEnabled(light)) {
      continue;
    }
    const vec3 pointToLight = localLightPosition(light) - hitPoint;
    const float distanceSq = dot(pointToLight, pointToLight);
    if (distanceSq <= 1.0e-8) {
      continue;
    }
    const vec3 lightDirection = pointToLight * inversesqrt(distanceSq);
    const float ndotl = max(dot(shadingNormal, lightDirection), 0.0);
    float attenuation =
        punctualRangeAttenuation(distanceSq, localLightRange(light));
    if (localLightType(light) == kLocalLightTypeSpot) {
      attenuation *= spotAngularAttenuation(
          localLightDirection(light), pointToLight, localLightInnerCos(light),
          localLightOuterCos(light));
    }
    const vec3 lightColor = localLightColor(light);
    const vec3 contribution = ddgiClampRadiance(
        diffuseColor * lightColor * localLightIntensity(light) * attenuation *
            ndotl / 3.14159265359,
        kDDGIRadianceDomainDirect);
    const float score = dot(contribution, vec3(0.2126, 0.7152, 0.0722));
    if (score <= 0.0) {
      continue;
    }
    ++eligibleCount;
    if (localLimit == 0u) {
      continue;
    }
    if (candidateCount == localLimit &&
        (score < candidateScores[localLimit - 1u] ||
         (score == candidateScores[localLimit - 1u] &&
          lightIndex > candidateIndices[localLimit - 1u]))) {
      continue;
    }
    uint insert = min(candidateCount, localLimit - 1u);
    while (insert > 0u && (score > candidateScores[insert - 1u] ||
                           (score == candidateScores[insert - 1u] &&
                            lightIndex < candidateIndices[insert - 1u]))) {
      candidateScores[insert] = candidateScores[insert - 1u];
      candidateIndices[insert] = candidateIndices[insert - 1u];
      --insert;
    }
    candidateScores[insert] = score;
    candidateIndices[insert] = lightIndex;
    candidateCount = min(candidateCount + 1u, localLimit);
  }
  if ((totalLocalLightCount > sampledLocalLightCount ||
       eligibleCount > localLimit) &&
      ddgiDiagnosticCountersEnabled()) {
    atomicAdd(pc.traceInputs.counters.localLightTruncations, 1u);
  }

  const vec3 directionalDirection =
      selectedDirectionalLightCount > 0u
          ? normalize(-pc.directionalDirectionIlluminance.xyz)
          : vec3(0.0);
  const float directionalNdotL =
      selectedDirectionalLightCount > 0u
          ? max(dot(shadingNormal, directionalDirection), 0.0)
          : 0.0;
  const vec3 directionalContribution = ddgiClampRadiance(
      diffuseColor * pc.directionalColor.rgb *
          pc.directionalDirectionIlluminance.w * directionalNdotL /
          3.14159265359 * float(totalDirectionalLightCount),
      kDDGIRadianceDomainDirect);
  const float directionalScore =
      dot(directionalContribution, vec3(0.2126, 0.7152, 0.0722));
  float totalScore = max(directionalScore, 0.0);
  for (uint candidate = 0u; candidate < candidateCount; ++candidate) {
    totalScore += candidateScores[candidate] * localDomainScale;
  }
  if (totalScore <= 1.0e-8) {
    return vec3(0.0);
  }

  float selected = ddgiDirectLightRandom(sampleSeed, volumeSlot) * totalScore;
  vec3 selectedDirection = directionalDirection;
  vec3 selectedContribution = directionalContribution;
  float selectedDistance = float(pc.maxCandidates >> 16u);
  float selectedScore = directionalScore;
  bool selectedLocal = false;
  bool found = directionalScore > 0.0 && selected < directionalScore;
  selected -= directionalScore;
  for (uint candidate = 0u; candidate < candidateCount; ++candidate) {
    const float candidateDomainScore =
        candidateScores[candidate] * localDomainScale;
    if (found || selected >= candidateDomainScore) {
      selected -= found ? 0.0 : candidateDomainScore;
      continue;
    }
    const LocalLightGpuData light =
        pc.traceInputs
            .lights[sampledLocalLightOffset + candidateIndices[candidate]];
    const vec3 pointToLight = localLightPosition(light) - hitPoint;
    const float distanceSq = dot(pointToLight, pointToLight);
    const vec3 lightDirection = pointToLight * inversesqrt(distanceSq);
    float attenuation =
        punctualRangeAttenuation(distanceSq, localLightRange(light));
    if (localLightType(light) == kLocalLightTypeSpot) {
      attenuation *= spotAngularAttenuation(
          localLightDirection(light), pointToLight, localLightInnerCos(light),
          localLightOuterCos(light));
    }
    selectedDirection = lightDirection;
    selectedDistance = sqrt(distanceSq);
    selectedContribution = ddgiClampRadiance(
        diffuseColor * localLightColor(light) * localLightIntensity(light) *
            attenuation * max(dot(shadingNormal, lightDirection), 0.0) /
            3.14159265359,
        kDDGIRadianceDomainDirect);
    selectedScore = candidateScores[candidate];
    selectedLocal = true;
    found = true;
    break;
  }
  if (!found || selectedScore <= 0.0) {
    return vec3(0.0);
  }

  const float configuredBias =
      selectedLocal ? volume.rayBiases.y : volume.rayBiases.z;
  const float shadowBias = clamp(0.75 * minimumSpacing * configuredBias, 0.001,
                                 max(0.25 * minimumSpacing, 0.001));
  const float offsetSign =
      dot(geometricNormal, selectedDirection) >= 0.0 ? 1.0 : -1.0;
  const vec3 shadowOrigin =
      hitPoint + geometricNormal * (shadowBias * offsetSign);
  const float traceDistance = max(selectedDistance - shadowBias, 0.0);
  if (traceDistance <= 0.001 ||
      !ddgiDirectLightVisible(shadowOrigin, selectedDirection, traceDistance,
                              volumeSlot, selectedLocal)) {
    return vec3(0.0);
  }
  return ddgiClampRadiance(selectedContribution * (totalScore / selectedScore),
                           kDDGIRadianceDomainDirect);
}

void main() {
  if (gl_WorkGroupID.x >= pc.updateCount) {
    return;
  }
  const uint updateIndex = (pc.raysPerProbe >> 12u) + gl_WorkGroupID.x;
  const DDGIProbeUpdateEntryGpu update = pc.updates.values[updateIndex];
  const uint updateRay =
      gl_WorkGroupID.y * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
  if (updateRay >= update.rayCount) {
    return;
  }
  const uint rayIndex = update.rayBase + updateRay;
  DDGIVolumeGpuData volume = pc.frame.volumes[update.volumeSlot];
  const uint probeState =
      volume.probeStates.values[update.probeId].stateAgeFlags.x;
  const bool reclassify = (update.flags & 1u) != 0u;
  const bool wake = (update.flags & 2u) != 0u;
  if ((probeState == kDDGIProbeStateOff && !reclassify) ||
      (probeState == kDDGIProbeStateSleeping && !reclassify && !wake)) {
    pc.results.values[rayIndex].radianceAndDistance = vec4(0.0);
    pc.results.values[rayIndex].metadata =
        uvec4(0u, update.volumeSlot, update.probeId, 0u);
    return;
  }
  const uvec3 counts = volume.probeCountsAndCount.xyz;
  const uint xy = counts.x * counts.y;
  const uvec3 physical =
      uvec3(update.probeId % counts.x, (update.probeId % xy) / counts.x,
            update.probeId / xy);
  const uvec3 logical =
      (physical + counts - volume.ringOriginAndFlags.xyz) % counts;
  const vec3 localOrigin =
      ddgiNominalLocalPosition(volume, logical) +
      volume.probeStates.values[update.probeId].relocation.xyz;
  const vec3 origin = (volume.worldFromLocal * vec4(localOrigin, 1.0)).xyz;
  const uint raySetSeed =
      ddgiProbeUpdateRaySeed(volume, update.probeId, pc.frameSeed);
  const vec3 direction =
      ddgiRayDirection(updateRay, update.rayCount, raySetSeed);
  rayQueryEXT query;
  rayQueryInitializeEXT(query, kSceneTlas, gl_RayFlagsNoneEXT, 0xff, origin,
                        ddgiProbeRayTMin(volume), direction,
                        volume.centerHalfExtentsAndMaxDistance.w);
  uint candidates = 0u;
  float containmentDistance = 0.0;
  uint containmentFlags = 0u;
  bool overflow = false;
  const bool classificationRay = (update.flags & (1u << 4u)) != 0u;
  while (rayQueryProceedEXT(query)) {
    if (ddgiDiagnosticCountersEnabled()) {
      atomicAdd(pc.traceInputs.counters.primaryCandidateIntersections, 1u);
    }
    if (++candidates > (pc.maxCandidates & 0xffffu)) {
      overflow = true;
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.candidateOverflows, 1u);
      }
      break;
    }
    const uint instanceIndex =
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
    const RtInstanceGpuData instance = pc.instances.values[instanceIndex];
    const uint geometryIndex =
        instance.geometryRenderableFlags.x +
        rayQueryGetIntersectionGeometryIndexEXT(query, false);
    RtGeometryGpuData geometry = pc.geometries.values[geometryIndex];
    if ((geometry.flags &
         (kRtGeometryAlphaBlended | kRtGeometryTransmission)) != 0u) {
      continue;
    }
    const uint primitive =
        rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
    const vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, false);
    const float candidateDistance = rayQueryGetIntersectionTEXT(query, false);
    if (!rtAlphaPasses(geometry, instance, primitive, bary, pc.materials,
                       pc.materialSamplerId, candidateDistance,
                       ddgiPresetRayCount())) {
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.alphaCandidateRejections, 1u);
      }
      continue;
    }
    const bool front = rayQueryGetIntersectionFrontFaceEXT(query, false);
    if (!front && classificationRay &&
        instance.geometryRenderableFlags.w == 0u) {
      const float distance = rayQueryGetIntersectionTEXT(query, false);
      if (containmentDistance == 0.0 || distance < containmentDistance) {
        containmentDistance = distance;
        containmentFlags = 0u;
      }
      continue;
    }
    if (!front && (geometry.flags & kRtGeometryDoubleSided) == 0u) {
      if (ddgiDiagnosticCountersEnabled()) {
        atomicAdd(pc.traceInputs.counters.backfaceCandidateRejections, 1u);
      }
      const float distance = rayQueryGetIntersectionTEXT(query, false);
      if (containmentDistance == 0.0 || distance < containmentDistance) {
        containmentDistance = distance;
        containmentFlags = instance.geometryRenderableFlags.w;
      }
      continue;
    }
    rayQueryConfirmIntersectionEXT(query);
  }
  DDGIRayResultGpuData result;
  result.radianceAndDistance = vec4(0.0, 0.0, 0.0, 0.0);
  result.metadata = uvec4(0u, update.volumeSlot, update.probeId, 0u);
  if (overflow) {
    result.metadata.x = 3u;
  } else if (rayQueryGetIntersectionTypeEXT(query, true) !=
             gl_RayQueryCommittedIntersectionNoneEXT) {
    const uint instanceIndex =
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    const RtInstanceGpuData instance = pc.instances.values[instanceIndex];
    const uint geometryIndex =
        instance.geometryRenderableFlags.x +
        rayQueryGetIntersectionGeometryIndexEXT(query, true);
    RtGeometryGpuData geometry = pc.geometries.values[geometryIndex];
    const uint primitive =
        rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    const vec2 bary = rayQueryGetIntersectionBarycentricsEXT(query, true);
    const float hitDistance = rayQueryGetIntersectionTEXT(query, true);
    if (classificationRay) {
      result.radianceAndDistance.w = hitDistance;
      result.metadata.x = 1u;
      result.metadata.w = instance.geometryRenderableFlags.w;
      pc.results.values[rayIndex] = result;
      return;
    }
    vec3 geometricNormal = rtHitGeometricNormal(geometry, instance, primitive);
    if (dot(geometricNormal, -direction) < 0.0) {
      geometricNormal = -geometricNormal;
    }
    vec3 normal = rtHitShadingNormal(
        geometry, instance, primitive, bary,
        pc.materials.materials[geometry.materialIndex], pc.materialSamplerId,
        hitDistance, ddgiPresetRayCount());
    if (dot(normal, -direction) < 0.0) {
      normal = -normal;
    }
    const MaterialHeaderGpuData material =
        pc.materials.materials[geometry.materialIndex];
    const vec4 baseColor =
        rtBaseColor(geometry, instance, primitive, bary, material,
                    pc.materialSamplerId, hitDistance, ddgiPresetRayCount());
    const float metallic =
        rtMetallic(geometry, instance, primitive, bary, material,
                   pc.materialSamplerId, hitDistance, ddgiPresetRayCount());
    vec3 radiance = ddgiClampRadiance(
        rtEmissive(geometry, instance, primitive, bary, material,
                   pc.materialSamplerId, hitDistance, ddgiPresetRayCount()),
        kDDGIRadianceDomainEmissive);
    const vec3 hitPoint = origin + direction * hitDistance;
    const float minSpacing =
        min(min(volume.probeSpacingAndBias.x, volume.probeSpacingAndBias.y),
            volume.probeSpacingAndBias.z);
    radiance += ddgiDirectLighting(hitPoint, geometricNormal, normal,
                                   baseColor.rgb * (1.0 - metallic), minSpacing,
                                   update.volumeSlot,
                                   ddgiDirectLightHash(raySetSeed ^ updateRay));
    if ((pc.maxLocalLights & 0x80000000u) != 0u) {
      const DDGIQueryResult bounce =
          queryDDGI(pc.frame, hitPoint, normal, -direction,
                    (pc.frame.activeCountDebugFlagsSampler.y >> 16u) & 0xffu);
      vec3 contribution = ddgiFiniteRadiance(bounce.irradiance) *
                          ddgiFiniteRadiance(baseColor.rgb) *
                          max(1.0 - metallic, 0.0) / 3.14159265359;
      const float luminance = dot(contribution, vec3(0.2126, 0.7152, 0.0722));
      contribution *= min(1.0, pc.directionalColor.w / max(luminance, 1.0e-6));
      radiance +=
          ddgiClampRadiance(contribution, kDDGIRadianceDomainMultiBounce);
    }
    result.radianceAndDistance = vec4(
        ddgiClampRadiance(radiance, kDDGIRadianceDomainFinal), hitDistance);
    result.metadata.x = 1u;
    result.metadata.w = instance.geometryRenderableFlags.w;
  } else if (containmentDistance > 0.0) {
    result.radianceAndDistance.w = -containmentDistance;
    result.metadata.x = 2u;
    result.metadata.w = containmentFlags;
  } else {
    if (classificationRay) {
      result.radianceAndDistance.w = -1.0;
      result.metadata.x = 0u;
      pc.results.values[rayIndex] = result;
      return;
    }
    const vec3 sky = pc.skyTextureId != kInvalidTextureBindlessIndex
                         ? textureBindlessCubeLod(
                               pc.skyTextureId, pc.skySamplerId, direction, 0.0)
                               .rgb
                         : vec3(0.0);
    result.radianceAndDistance =
        vec4(ddgiClampRadiance(sky, kDDGIRadianceDomainSky), -1.0);
    result.metadata.x = 0u;
  }
  pc.results.values[rayIndex] = result;
}
