#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 1) uniform sampler kSamplers[];
layout(set = 0, binding = 2, r16) uniform image2D kImagesR16[];

layout(push_constant) uniform constants {
  uint currentTexId;
  uint historyTexId;
  uint motionVectorTexId;
  uint reactiveMaskTexId;
  uint sceneDepthTexId;
  uint currentViewDepthTexId;
  uint previousSceneDepthTexId;
  uint edgeTexId;
  uint outputTexId;
  uint pointSamplerId;
  uint historySamplerId;
  uint width;
  uint height;
  uint currentWidth;
  uint currentHeight;
  uint flags;
  uint baseCurrentWeightBits;
  uint rejectedCurrentWeightBits;
  uint projectionType;
  float nearPlane;
  float farPlane;
  uint forceInvalidGeometry;
  uint provenStaticCameraOnly;
}
pc;

const uint kTemporalFlagHistoryValid = 1u << 0u;
const uint kMotionClassInvalid = 0u;
const uint kMotionClassStaticCameraOnly = 1u;
const uint kMotionClassFull = 2u;
const uint kMotionClassBackgroundRotation = 3u;
const float kMaxVisibilityReduction = 0.45;
const float kVelocityRejectPixels = 2.0;
const float kDepthEdgeRejectThreshold = 0.35;
const float kPreviousDepthAbsoluteThreshold = 0.05;
const float kPreviousDepthRelativeThreshold = 0.02;

float pushFloat(uint bits) { return uintBitsToFloat(bits); }

bool historyValid() { return (pc.flags & kTemporalFlagHistoryValid) != 0u; }

bool uvInBounds(vec2 uv) {
  return all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)));
}

float sampleCurrentTexel(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.currentTexId)], pos, 0).r;
}

float sampleHistory(vec2 uv) {
  return texture(nonuniformEXT(sampler2D(kTextures2D[pc.historyTexId],
                                         kSamplers[pc.historySamplerId])),
                 uv)
      .r;
}

vec2 sampleVelocity(vec2 uv) {
  return texture(nonuniformEXT(sampler2D(kTextures2D[pc.motionVectorTexId],
                                         kSamplers[pc.pointSamplerId])),
                 uv)
      .rg;
}

float sampleSceneDepth(vec2 uv) {
  return texture(nonuniformEXT(sampler2D(kTextures2D[pc.sceneDepthTexId],
                                         kSamplers[pc.pointSamplerId])),
                 uv)
      .r;
}

float sampleReactiveMask(vec2 uv) {
  return texture(nonuniformEXT(sampler2D(kTextures2D[pc.reactiveMaskTexId],
                                         kSamplers[pc.pointSamplerId])),
                 uv)
      .r;
}

uint classifyMotion(float sceneDepth, vec2 motion, float reactive) {
  if (sceneDepth >= 0.999999) {
    return kMotionClassBackgroundRotation;
  }
  if (pc.forceInvalidGeometry != 0u || any(isnan(motion)) ||
      any(isinf(motion)) || any(greaterThan(abs(motion), vec2(8.0))) ||
      reactive > (0.5 / 255.0)) {
    return kMotionClassInvalid;
  }
  return pc.provenStaticCameraOnly != 0u ? kMotionClassStaticCameraOnly
                                         : kMotionClassFull;
}

float sampleCurrentViewDepth(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.currentViewDepthTexId)], pos,
                    0)
      .r;
}

float samplePreviousSceneDepth(vec2 uv) {
  return texture(
             nonuniformEXT(sampler2D(kTextures2D[pc.previousSceneDepthTexId],
                                     kSamplers[pc.pointSamplerId])),
             uv)
      .r;
}

float linearizeDepth(float deviceDepth) {
  float nearPlane = max(pc.nearPlane, 1.0e-4);
  float farPlane = max(pc.farPlane, nearPlane + 1.0e-3);
  float clampedDeviceDepth = clamp(deviceDepth, 0.0, 1.0);
  if (pc.projectionType != 0u) {
    return mix(nearPlane, farPlane, clampedDeviceDepth);
  }
  return (nearPlane * farPlane) /
         max(farPlane - clampedDeviceDepth * (farPlane - nearPlane), 1.0e-4);
}

float samplePackedEdges(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.edgeTexId)], pos, 0).r;
}

vec4 unpackEdges(float packedEdges) {
  uint packedValue = uint(packedEdges * 255.5);
  vec4 edgesLRTB;
  edgesLRTB.x = float((packedValue >> 6) & 0x03u) / 3.0;
  edgesLRTB.y = float((packedValue >> 4) & 0x03u) / 3.0;
  edgesLRTB.z = float((packedValue >> 2) & 0x03u) / 3.0;
  edgesLRTB.w = float((packedValue >> 0) & 0x03u) / 3.0;
  return clamp(edgesLRTB, 0.0, 1.0);
}

float edgeForDirection(vec4 edges, vec2 direction) {
  vec2 axisWeight = abs(direction);
  float weightSum = axisWeight.x + axisWeight.y;
  if (weightSum <= 1.0e-5) {
    return 1.0;
  }
  float horizontal = direction.x < 0.0 ? edges.x : edges.y;
  float vertical = direction.y < 0.0 ? edges.z : edges.w;
  return (horizontal * axisWeight.x + vertical * axisWeight.y) / weightSum;
}

float representativeDepth(ivec2 currentPos) {
  ivec2 outputSize = ivec2(int(pc.width), int(pc.height));
  ivec2 currentSize = ivec2(int(pc.currentWidth), int(pc.currentHeight));
  if (all(equal(outputSize, currentSize))) {
    return sampleCurrentViewDepth(currentPos);
  }

  ivec2 basePos =
      ivec2(floor(vec2(currentPos) * vec2(outputSize) / vec2(currentSize)));
  ivec2 endPos = ivec2(floor(vec2(currentPos + ivec2(1)) * vec2(outputSize) /
                             vec2(currentSize))) -
                 ivec2(1);
  basePos = clamp(basePos, ivec2(0), outputSize - ivec2(1));
  endPos = clamp(max(endPos, basePos), ivec2(0), outputSize - ivec2(1));
  float closestDepth = 0.0;
  for (int y = basePos.y; y <= endPos.y; ++y) {
    for (int x = basePos.x; x <= endPos.x; ++x) {
      float candidateDepth = sampleCurrentViewDepth(ivec2(x, y));
      if (candidateDepth > 1.0e-5 &&
          (closestDepth <= 1.0e-5 || candidateDepth < closestDepth)) {
        closestDepth = candidateDepth;
      }
    }
  }
  return closestDepth;
}

float spatialCurrent(ivec2 outputPos) {
  ivec2 outputSize = ivec2(int(pc.width), int(pc.height));
  ivec2 currentSize = ivec2(int(pc.currentWidth), int(pc.currentHeight));
  if (all(equal(outputSize, currentSize))) {
    return sampleCurrentTexel(outputPos);
  }

  float receiverDepth = sampleCurrentViewDepth(outputPos);
  if (receiverDepth <= 1.0e-5) {
    return 1.0;
  }
  vec2 currentCoord =
      (vec2(outputPos) + vec2(0.5)) * vec2(currentSize) / vec2(outputSize) -
      vec2(0.5);
  ivec2 basePos = ivec2(floor(currentCoord));
  vec2 fraction = fract(currentCoord);
  vec4 receiverEdges = unpackEdges(samplePackedEdges(outputPos));
  float visibilitySum = 0.0;
  float weightSum = 0.0;
  for (int y = 0; y < 2; ++y) {
    for (int x = 0; x < 2; ++x) {
      ivec2 candidatePos =
          clamp(basePos + ivec2(x, y), ivec2(0), currentSize - ivec2(1));
      float candidateDepth = representativeDepth(candidatePos);
      if (candidateDepth <= 1.0e-5) {
        continue;
      }
      vec2 axisWeight = vec2(x == 0 ? 1.0 - fraction.x : fraction.x,
                             y == 0 ? 1.0 - fraction.y : fraction.y);
      float weight = axisWeight.x * axisWeight.y;
      float depthThreshold =
          max(0.05, 0.02 * max(receiverDepth, candidateDepth));
      weight *= 1.0 - smoothstep(depthThreshold, depthThreshold * 2.0,
                                 abs(receiverDepth - candidateDepth));
      vec2 candidateOutputPos = (vec2(candidatePos) + vec2(0.5)) *
                                    vec2(outputSize) / vec2(currentSize) -
                                vec2(0.5);
      vec2 direction = candidateOutputPos - vec2(outputPos);
      weight *= mix(0.15, 1.0, edgeForDirection(receiverEdges, direction));
      visibilitySum += sampleCurrentTexel(candidatePos) * weight;
      weightSum += weight;
    }
  }
  if (weightSum > 1.0e-5) {
    return visibilitySum / weightSum;
  }
  ivec2 nearestPos =
      clamp(ivec2(round(currentCoord)), ivec2(0), currentSize - ivec2(1));
  return sampleCurrentTexel(nearestPos);
}

void currentNeighborhood(ivec2 pos, float centerVisibility,
                         out float minVisibility, out float maxVisibility) {
  ivec2 outputSize = ivec2(int(pc.width), int(pc.height));
  ivec2 currentSize = ivec2(int(pc.currentWidth), int(pc.currentHeight));
  ivec2 centerPos = clamp(ivec2(round((vec2(pos) + vec2(0.5)) *
                                          vec2(currentSize) / vec2(outputSize) -
                                      vec2(0.5))),
                          ivec2(0), currentSize - ivec2(1));
  minVisibility = centerVisibility;
  maxVisibility = centerVisibility;
  for (int y = -1; y <= 1; ++y) {
    for (int x = -1; x <= 1; ++x) {
      if (x == 0 && y == 0) {
        continue;
      }
      ivec2 samplePos =
          clamp(centerPos + ivec2(x, y), ivec2(0), currentSize - ivec2(1));
      float visibility = sampleCurrentTexel(samplePos);
      minVisibility = min(minVisibility, visibility);
      maxVisibility = max(maxVisibility, visibility);
    }
  }
}

void main() {
  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = ivec2(int(pc.width), int(pc.height));
  if (pos.x >= size.x || pos.y >= size.y) {
    return;
  }

  float currentVisibility = spatialCurrent(pos);
  vec2 uv = (vec2(pos) + vec2(0.5)) / vec2(size);
  if (!historyValid()) {
    imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
               vec4(currentVisibility, 0.0, 0.0, 0.0));
    return;
  }

  vec2 velocity = sampleVelocity(uv);
  vec2 historyUv = uv + velocity;
  float sceneDepth = sampleSceneDepth(uv);
  uint motionClass =
      classifyMotion(sceneDepth, velocity, sampleReactiveMask(uv));
  bool validMotionClass = motionClass == kMotionClassStaticCameraOnly ||
                          motionClass == kMotionClassFull;
  bool validHistory =
      validMotionClass && uvInBounds(historyUv) && sceneDepth < 0.999999;
  if (validHistory) {
    float previousDeviceDepth = samplePreviousSceneDepth(historyUv);
    float currentViewDepth = sampleCurrentViewDepth(pos);
    float previousViewDepth = linearizeDepth(previousDeviceDepth);
    float depthThreshold = max(kPreviousDepthAbsoluteThreshold,
                               kPreviousDepthRelativeThreshold *
                                   max(currentViewDepth, previousViewDepth));
    validHistory = previousDeviceDepth < 0.999999 &&
                   abs(currentViewDepth - previousViewDepth) <= depthThreshold;
  }
  if (!validHistory) {
    imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
               vec4(currentVisibility, 0.0, 0.0, 0.0));
    return;
  }

  float history = sampleHistory(historyUv);
  float minVisibility;
  float maxVisibility;
  currentNeighborhood(pos, currentVisibility, minVisibility, maxVisibility);
  float historyVisibility = clamp(history, minVisibility, maxVisibility);

  vec4 edges = unpackEdges(samplePackedEdges(pos));
  float motionPixels = length(velocity * vec2(size));
  bool velocityRejected = motionPixels > kVelocityRejectPixels;
  bool depthEdgeRejected = min(min(edges.x, edges.y), min(edges.z, edges.w)) <
                           kDepthEdgeRejectThreshold;
  float currentWeight = (velocityRejected || depthEdgeRejected)
                            ? pushFloat(pc.rejectedCurrentWeightBits)
                            : pushFloat(pc.baseCurrentWeightBits);
  currentWeight = clamp(currentWeight, 0.0, 1.0);

  float historyWeight = 1.0 - currentWeight;
  float visibility = clamp(currentVisibility * currentWeight +
                               historyVisibility * historyWeight,
                           1.0 - kMaxVisibilityReduction, 1.0);
  imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
             vec4(visibility, 0.0, 0.0, 0.0));
}
