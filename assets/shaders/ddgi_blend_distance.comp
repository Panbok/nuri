layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#define NURI_CUSTOM_PUSH_CONSTANTS 1
#include "common.sp"
#include "ddgi_common.sp"

layout(set = 0, binding = 2, rg16f) uniform image2D kImagesRG16F[];
layout(std430, buffer_reference) readonly buffer DDGIProbeUpdateBuffer {
  DDGIProbeUpdateEntryGpu values[];
};
layout(std430, buffer_reference) readonly buffer DDGIRayResultBuffer {
  DDGIRayResultGpuData values[];
};
layout(push_constant) uniform PushConstants {
  DDGIFrameBuffer frame;
  DDGIProbeUpdateBuffer updates;
  DDGIRayResultBuffer results;
  uint updateCount;
  uint updateOffset;
  uint volumeSlot;
  uint outputTextureId;
  uint raysPerProbe;
  float hysteresis;
  uint clearMode;
  uint historyValid;
  uint frameSeed;
  float responseHysteresisScale;
}
pc;

void main() {
  if (pc.clearMode == 1u) {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(
            pixel, imageSize(kImagesRG16F[nonuniformEXT(pc.outputTextureId)]))))
      imageStore(kImagesRG16F[nonuniformEXT(pc.outputTextureId)], pixel,
                 vec4(1.0, 1.0, 0.0, 0.0));
    return;
  }
  if (pc.clearMode == 2u) {
    if (gl_WorkGroupID.x >= pc.updateCount)
      return;
    const uint updateIndex = pc.updateOffset + gl_WorkGroupID.x;
    const DDGIProbeUpdateEntryGpu update = pc.updates.values[updateIndex];
    if (update.volumeSlot != pc.volumeSlot)
      return;
    DDGIVolumeGpuData volume = pc.frame.volumes[pc.volumeSlot];
    const uvec2 tile = uvec2(update.probeId % volume.distanceAtlas.z,
                             update.probeId / volume.distanceAtlas.z);
    for (uint texel = gl_LocalInvocationIndex; texel < 324u; texel += 64u) {
      const uvec2 tilePixel = uvec2(texel % 18u, texel / 18u);
      imageStore(kImagesRG16F[nonuniformEXT(pc.outputTextureId)],
                 ivec2(tile * 18u + tilePixel), vec4(1.0, 1.0, 0.0, 0.0));
    }
    return;
  }
  if (gl_WorkGroupID.x >= pc.updateCount)
    return;
  const uint updateIndex = pc.updateOffset + gl_WorkGroupID.x;
  const DDGIProbeUpdateEntryGpu update = pc.updates.values[updateIndex];
  if (update.volumeSlot != pc.volumeSlot)
    return;
  DDGIVolumeGpuData volume = pc.frame.volumes[pc.volumeSlot];
  const uint probeState =
      volume.probeStates.values[update.probeId].stateAgeFlags.x;
  if (probeState == kDDGIProbeStateUninitialized ||
      probeState == kDDGIProbeStateOff || probeState == kDDGIProbeStateSleeping)
    return;
  const uint localLinear = gl_LocalInvocationIndex;
  const uvec2 tile = uvec2(update.probeId % volume.distanceAtlas.z,
                           update.probeId / volume.distanceAtlas.z);
  for (uint texel = localLinear; texel < 256u; texel += 64u) {
    const uvec2 interior = uvec2(texel % 16u, texel / 16u);
    const uvec2 tilePixel = interior + 1u;
    const vec3 texelDirection =
        ddgiOctDecode(vec2(interior) / 15.0 * 2.0 - 1.0);
    float first = 0.0;
    float second = 0.0;
    float weight = 0.0;
    for (uint ray = 0u; ray < update.rayCount; ++ray) {
      const vec3 direction =
          ddgiRayDirection(ray, update.rayCount, pc.frameSeed);
      const float w = max(dot(texelDirection, direction), 0.0);
      const DDGIRayResultGpuData result =
          pc.results.values[update.rayBase + ray];
      float d = result.metadata.x == 0u
                    ? 1.0
                    : (result.metadata.x == 2u
                           ? 0.2 * abs(result.radianceAndDistance.w)
                           : max(result.radianceAndDistance.w, 0.0)) /
                          max(volume.centerHalfExtentsAndMaxDistance.w, 1.0e-6);
      d = isnan(d) || isinf(d) ? 0.0 : clamp(d, 0.0, 1.0);
      first += d * w;
      second += d * d * w;
      weight += w;
    }
    const vec2 moments =
        ddgiFiniteUnitMoments(vec2(first, second) / max(weight, 1.0e-6));
    const ivec2 pixel = ivec2(tile * 18u + tilePixel);
    const vec2 oldValue = ddgiFiniteUnitMoments(
        imageLoad(kImagesRG16F[nonuniformEXT(pc.outputTextureId)], pixel).rg);
    const bool probeHistoryValid =
        volume.probeStates.values[update.probeId].stateAgeFlags.y != 0u &&
        probeState != kDDGIProbeStateNewlyAwake &&
        probeState != kDDGIProbeStateNewlyVigilant;
    float h = pc.historyValid != 0u && probeHistoryValid ? pc.hysteresis : 0.0;
    if ((update.flags & (1u << 3u)) != 0u) {
      h *= pc.responseHysteresisScale;
    }
    imageStore(
        kImagesRG16F[nonuniformEXT(pc.outputTextureId)], pixel,
        vec4(ddgiFiniteUnitMoments(mix(moments, oldValue, h)), 0.0, 0.0));
  }
  memoryBarrierImage();
  barrier();
  for (uint texel = localLinear; texel < 324u; texel += 64u) {
    const uvec2 tilePixel = uvec2(texel % 18u, texel / 18u);
    if (all(greaterThan(tilePixel, uvec2(0u))) &&
        all(lessThan(tilePixel, uvec2(17u)))) {
      continue;
    }
    const ivec2 outputPixel = ivec2(tile * 18u + tilePixel);
    const ivec2 copyPixel =
        ivec2(tile * 18u + ddgiBorderCopyCoordinate(tilePixel, 16u));
    imageStore(
        kImagesRG16F[nonuniformEXT(pc.outputTextureId)], outputPixel,
        vec4(ddgiFiniteUnitMoments(
                 imageLoad(kImagesRG16F[nonuniformEXT(pc.outputTextureId)],
                           copyPixel)
                     .rg),
             0.0, 0.0));
  }
}
