#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 2, r16) uniform image2D kImagesR16[];

layout(push_constant) uniform constants {
  uint sourceTexId;
  uint outputTexId;
  uint edgeTexId;
  uint width;
  uint height;
}
pc;

const float kMaxVisibilityReduction = 0.45;

float sampleAo(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.sourceTexId)], pos, 0).r;
}

float samplePackedEdges(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.edgeTexId)], pos, 0).r;
}

vec4 unpackEdges(float packedEdges) {
  uint packedValue = uint(packedEdges * 255.5);
  vec4 edgesLRTB;
  edgesLRTB.x = float((packedValue >> 6) & 0x03u) / 3.0;
  edgesLRTB.y = float((packedValue >> 4) & 0x03u) / 3.0;
  edgesLRTB.z = float((packedValue >> 2) & 0x03u) / 3.0;
  edgesLRTB.w = float((packedValue >> 0) & 0x03u) / 3.0;
  return clamp(edgesLRTB, 0.0, 1.0);
}

float edgeWeightForOffset(ivec2 offset, vec4 centerEdges, vec4 neighborEdges) {
  if (offset.x < 0 && offset.y == 0) {
    return centerEdges.x * neighborEdges.y;
  }
  if (offset.x > 0 && offset.y == 0) {
    return centerEdges.y * neighborEdges.x;
  }
  if (offset.x == 0 && offset.y < 0) {
    return centerEdges.z * neighborEdges.w;
  }
  if (offset.x == 0 && offset.y > 0) {
    return centerEdges.w * neighborEdges.z;
  }

  float horizontal = offset.x < 0 ? centerEdges.x : centerEdges.y;
  float vertical = offset.y < 0 ? centerEdges.z : centerEdges.w;
  return 0.425 * (horizontal + vertical);
}

void addSample(ivec2 pos, ivec2 offset, ivec2 maxPos, vec4 centerEdges,
               inout float visibilitySum, inout float weightSum) {
  ivec2 samplePos = clamp(pos + offset, ivec2(0), maxPos);
  vec4 neighborEdges = unpackEdges(samplePackedEdges(samplePos));
  float weight = edgeWeightForOffset(offset, centerEdges, neighborEdges);
  visibilitySum += sampleAo(samplePos) * weight;
  weightSum += weight;
}

void main() {
  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = ivec2(int(pc.width), int(pc.height));
  if (pos.x >= size.x || pos.y >= size.y) {
    return;
  }

  float center = sampleAo(pos);
  vec4 centerEdges = unpackEdges(samplePackedEdges(pos));
  ivec2 maxPos = size - ivec2(1);

  const float centerWeight = 1.0;
  float visibilitySum = center * centerWeight;
  float weightSum = centerWeight;

  addSample(pos, ivec2(-1, 0), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(1, 0), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(0, -1), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(0, 1), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(-1, -1), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(1, -1), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(-1, 1), maxPos, centerEdges, visibilitySum, weightSum);
  addSample(pos, ivec2(1, 1), maxPos, centerEdges, visibilitySum, weightSum);

  float invWeight = 1.0 / max(weightSum, 1.0e-4);
  float visibility =
      clamp(visibilitySum * invWeight, 1.0 - kMaxVisibilityReduction, 1.0);
  imageStore(kImagesR16[nonuniformEXT(pc.outputTexId)], pos,
             vec4(visibility, 0.0, 0.0, 0.0));
}
