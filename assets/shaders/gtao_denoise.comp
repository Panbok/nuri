#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D kTextures2D[];
layout(set = 0, binding = 1) uniform sampler kSamplers[];
layout(set = 0, binding = 2, rgba16f) uniform image2D kImagesRGBA16F[];

layout(push_constant) uniform constants {
  uint sourceTexId;
  uint outputTexId;
  uint depthTexId;
  uint width;
  uint height;
  uint passIndex;
  float normalSimilarityMin;
  float normalSimilarityMax;
  float depthScaleMultiplier;
  float depthScaleMin;
  float spatialWeightNear;
  float spatialWeightFar;
}
pc;

const float kNormalEpsilon = 1.0e-6;

vec4 sampleAo(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.sourceTexId)], pos, 0);
}

float sampleViewDepth(ivec2 pos) {
  return texelFetch(kTextures2D[nonuniformEXT(pc.depthTexId)], pos, 0).r;
}

vec3 safeNormalize(vec3 v, vec3 fallback) {
  float l = length(v);
  return l < kNormalEpsilon ? fallback : v / l;
}

void main() {
  ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = ivec2(int(pc.width), int(pc.height));
  if (pos.x >= size.x || pos.y >= size.y) {
    return;
  }

  vec4 center = sampleAo(pos);
  float centerDepth = sampleViewDepth(pos);
  vec3 centerNormal =
      safeNormalize(center.xyz * 2.0 - 1.0, vec3(0.0, 0.0, 1.0));
  vec4 accum = center * 2.0;
  float weightSum = 2.0;
  int axis = int(pc.passIndex & 1u);

  for (int offset = -2; offset <= 2; ++offset) {
    if (offset == 0) {
      continue;
    }
    ivec2 samplePos = pos + (axis == 0 ? ivec2(offset, 0) : ivec2(0, offset));
    samplePos = clamp(samplePos, ivec2(0), size - ivec2(1));
    vec4 sampleValue = sampleAo(samplePos);
    float sampleDepth = sampleViewDepth(samplePos);
    vec3 sampleNormal =
        safeNormalize(sampleValue.xyz * 2.0 - 1.0, centerNormal);
    float normalWeight =
        smoothstep(pc.normalSimilarityMin, pc.normalSimilarityMax,
                   dot(centerNormal, sampleNormal));
    float depthDelta = abs(sampleDepth - centerDepth);
    float depthScale =
        max(centerDepth * pc.depthScaleMultiplier, pc.depthScaleMin);
    float depthWeight = exp2(-depthDelta / depthScale);
    float spatialWeight = offset == -1 || offset == 1 ? pc.spatialWeightNear
                                                      : pc.spatialWeightFar;
    float weight = normalWeight * depthWeight * spatialWeight;
    accum += sampleValue * weight;
    weightSum += weight;
  }

  vec4 result = accum / max(weightSum, 1.0);
  vec3 bent = safeNormalize(result.xyz * 2.0 - 1.0, centerNormal);
  result.xyz = bent * 0.5 + 0.5;
  result.a = clamp(result.a, 0.0, 1.0);
  imageStore(kImagesRGBA16F[nonuniformEXT(pc.outputTexId)], pos, result);
}
