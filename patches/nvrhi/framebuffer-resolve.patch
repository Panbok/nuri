+    void CommandListWrapper::resolveFramebuffer(IFramebuffer* framebuffer)
+    {
+        if (!requireOpenState())
+            return;
+
+        if (!requireType(CommandQueue::Graphics, "resolveFramebuffer"))
+            return;
+
+        if (!framebuffer)
+        {
+            error("resolveFramebuffer: framebuffer is NULL");
+            return;
+        }
+
+        const FramebufferDesc& desc = framebuffer->getDesc();
+        bool hasResolveAttachment = false;
+        for (const auto& attachment : desc.colorAttachments)
+        {
+            hasResolveAttachment |= attachment.hasResolveAttachment();
+        }
+        hasResolveAttachment |= desc.depthAttachment.hasResolveAttachment();
+        if (!hasResolveAttachment)
+        {
+            error("resolveFramebuffer: framebuffer has no resolve attachments");
+            return;
+        }
+
+        m_CommandList->resolveFramebuffer(framebuffer);
+    }
