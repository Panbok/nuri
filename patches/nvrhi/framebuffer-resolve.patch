+    void CommandList::resolveFramebuffer(IFramebuffer* _framebuffer)
+    {
+        endRenderPass();
+
+        Framebuffer* framebuffer = checked_cast<Framebuffer*>(_framebuffer);
+        if (!framebuffer)
+            return;
+
+        if (m_EnableAutomaticBarriers)
+        {
+            setResourceStatesForFramebuffer(framebuffer);
+            m_BindingStatesDirty = true;
+        }
+        commitBarriers();
+
+        beginRenderPass(framebuffer);
+        endRenderPass();
+    }
